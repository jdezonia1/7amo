<Project Sdk="Microsoft.NET.Sdk">
  <!-- Static check of the WPF screens (runs on Linux, no WPF needed): every {Binding} path must exist on the type the
       screen is bound to. Not part of Raffaello.sln. Usage: dotnet run (app bin folder) (src/Raffaello.App) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>
</Project>
