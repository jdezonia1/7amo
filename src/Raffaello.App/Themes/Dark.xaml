<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DARK theme = NEAR-BLACK (default depth). Soft / True black presets: Services/ThemeService.DarkDepths.  theme: generated from design-system/project/tokens.json -->
    <Color x:Key="BgColor">#0E0E0E</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#0E0E0E"/>
    <Color x:Key="SurfaceColor">#161616</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161616"/>
    <Color x:Key="Surface2Color">#181818</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="#181818"/>
    <Color x:Key="InkColor">#F2F2F2</Color>
    <SolidColorBrush x:Key="InkBrush" Color="#F2F2F2"/>
    <Color x:Key="Ink2Color">#E0E0E0</Color>
    <SolidColorBrush x:Key="Ink2Brush" Color="#E0E0E0"/>
    <Color x:Key="MutedColor">#A6A6A6</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="#A6A6A6"/>
    <Color x:Key="LineColor">#2A2A2A</Color>
    <SolidColorBrush x:Key="LineBrush" Color="#2A2A2A"/>
    <Color x:Key="AccentColor">#7A0000</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#7A0000"/>
    <Color x:Key="AccentSoftColor">#1F0000</Color>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F0000"/>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <Color x:Key="YellowColor">#FFFF00</Color>
    <SolidColorBrush x:Key="YellowBrush" Color="#FFFF00"/>
    <Color x:Key="YellowSoftColor">#2B2B00</Color>
    <SolidColorBrush x:Key="YellowSoftBrush" Color="#2B2B00"/>
    <Color x:Key="YellowInkColor">#FFFF66</Color>
    <SolidColorBrush x:Key="YellowInkBrush" Color="#FFFF66"/>
    <Color x:Key="OnYellowColor">#1F1F1F</Color>
    <SolidColorBrush x:Key="OnYellowBrush" Color="#1F1F1F"/>
    <Color x:Key="GoodColor">#6FA584</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="#6FA584"/>
    <Color x:Key="GoodSoftColor">#12261A</Color>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#12261A"/>
    <Color x:Key="HeroColor">#121212</Color>
    <SolidColorBrush x:Key="HeroBrush" Color="#121212"/>
    <Color x:Key="HeroInkColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="HeroInkBrush" Color="#FFFFFF"/>
    <Color x:Key="GraphiteColor">#A6A6A6</Color>
    <SolidColorBrush x:Key="GraphiteBrush" Color="#A6A6A6"/>
    <Color x:Key="RowHoverColor">#1E1E1E</Color>
    <SolidColorBrush x:Key="RowHoverBrush" Color="#1E1E1E"/>
    <Color x:Key="OverlayColor">#B3000000</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000"/>
    <Color x:Key="ShadowColor">#40000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#40000000"/>
    <Color x:Key="InputBgColor">#121212</Color>
    <SolidColorBrush x:Key="InputBgBrush" Color="#121212"/>
    <Color x:Key="SelectionColor">#260707</Color>
    <SolidColorBrush x:Key="SelectionBrush" Color="#260707"/>
    <!-- table header band -->
    <Color x:Key="GridHeaderColor">#1C1C1C</Color>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#1C1C1C"/>

    <!-- semantic tokens (colour audit 03-Oct-2026): accent family, status tints, chrome -->
    <Color x:Key="AccentHoverColor">#700000</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#700000"/>
    <Color x:Key="AccentPressedColor">#4A0000</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A0000"/>
    <Color x:Key="DangerColor">#7A0000</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="#7A0000"/>
    <Color x:Key="DangerSoftColor">#2A0E0E</Color>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#2A0E0E"/>
    <Color x:Key="SuccessColor">#6FA584</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6FA584"/>
    <Color x:Key="SuccessSoftColor">#12261A</Color>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#12261A"/>
    <Color x:Key="InfoColor">#7F9BB8</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="#7F9BB8"/>
    <Color x:Key="InfoSoftColor">#142030</Color>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#142030"/>
    <Color x:Key="WarningColor">#FFFF00</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF00"/>
    <Color x:Key="WarningInkColor">#1F1F1F</Color>
    <SolidColorBrush x:Key="WarningInkBrush" Color="#1F1F1F"/>
    <Color x:Key="GridHeaderInkColor">#F2F2F2</Color>
    <SolidColorBrush x:Key="GridHeaderInkBrush" Color="#F2F2F2"/>
    <Color x:Key="GridHeaderLineColor">#7A0000</Color>
    <SolidColorBrush x:Key="GridHeaderLineBrush" Color="#7A0000"/>
    <Color x:Key="ChromeBorderColor">#2A2A2A</Color>
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#2A2A2A"/>
    <!-- side bar (navigation) - dark in both themes; in dark it is the same near-black as the panels -->
    <Color x:Key="SidebarBgColor">#161616</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#161616"/>
    <SolidColorBrush x:Key="SidebarBgHoverBrush" Color="#1E1E1E"/>
</ResourceDictionary>
