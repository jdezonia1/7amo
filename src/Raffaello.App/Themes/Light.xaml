    <SolidColorBrush x:Key="RowHoverBrush" Color="#F2F2F2"/>
    <Color x:Key="OverlayColor">#66000000</Color>
    <SolidColorBrush x:Key="OverlayBrush" Color="#66000000"/>
    <Color x:Key="ShadowColor">#0F000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#0F000000"/>
    <Color x:Key="InputBgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <Color x:Key="SelectionColor">#EFDCDC</Color>
    <SolidColorBrush x:Key="SelectionBrush" Color="#EFDCDC"/>
    <!-- table header band -->
    <Color x:Key="GridHeaderColor">#000000</Color>
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#000000"/>

    <!-- semantic tokens (colour audit 03-Oct-2026): accent family, status tints, chrome -->
    <Color x:Key="AccentHoverColor">#700000</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#700000"/>
    <Color x:Key="AccentPressedColor">#4A0000</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A0000"/>
    <Color x:Key="DangerColor">#5C0000</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="#5C0000"/>
    <Color x:Key="DangerSoftColor">#F3E3E3</Color>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#F3E3E3"/>
    <Color x:Key="SuccessColor">#2F5D43</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2F5D43"/>
    <Color x:Key="SuccessSoftColor">#E4EFE8</Color>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E4EFE8"/>
    <Color x:Key="InfoColor">#3A5068</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="#3A5068"/>
    <Color x:Key="InfoSoftColor">#E5EBF1</Color>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#E5EBF1"/>
