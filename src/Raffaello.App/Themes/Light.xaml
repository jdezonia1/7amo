<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- LIGHT theme: generated from design-system/project/tokens.json -->
    <Color x:Key="BgColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF"/>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <Color x:Key="Surface2Color">#F6F6F6</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F6F6F6"/>
    <Color x:Key="InkColor">#000000</Color>
    <SolidColorBrush x:Key="InkBrush" Color="#000000"/>
    <Color x:Key="Ink2Color">#262626</Color>
    <SolidColorBrush x:Key="Ink2Brush" Color="#262626"/>
    <Color x:Key="MutedColor">#666666</Color>
    <SolidColorBrush x:Key="MutedBrush" Color="#666666"/>
    <Color x:Key="LineColor">#D9D9D9</Color>
    <SolidColorBrush x:Key="LineBrush" Color="#D9D9D9"/>
    <Color x:Key="AccentColor">#5C0000</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#5C0000"/>
    <Color x:Key="AccentSoftColor">#F3E3E3</Color>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#F3E3E3"/>
