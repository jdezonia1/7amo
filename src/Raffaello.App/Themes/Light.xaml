    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#2A2A2A"/>
    <!-- side bar (navigation) - dark in both themes; in dark it is the same near-black as the panels -->
    <Color x:Key="SidebarBgColor">#1A1A1A</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SidebarBgHoverBrush" Color="#262626"/>
</ResourceDictionary>
