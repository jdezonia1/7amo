    <SolidColorBrush x:Key="YellowSoftBrush" Color="#FFF8C5"/>
    <Color x:Key="YellowInkColor">#4D4300</Color>
    <SolidColorBrush x:Key="YellowInkBrush" Color="#4D4300"/>
    <Color x:Key="OnYellowColor">#1F1F1F</Color>
    <SolidColorBrush x:Key="OnYellowBrush" Color="#1F1F1F"/>
    <Color x:Key="GoodColor">#2F5D43</Color>
    <SolidColorBrush x:Key="GoodBrush" Color="#2F5D43"/>
    <Color x:Key="GoodSoftColor">#E4EFE8</Color>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#E4EFE8"/>
    <Color x:Key="HeroColor">#000000</Color>
    <SolidColorBrush x:Key="HeroBrush" Color="#000000"/>
    <Color x:Key="HeroInkColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="HeroInkBrush" Color="#FFFFFF"/>
    <Color x:Key="GraphiteColor">#A6A6A6</Color>
