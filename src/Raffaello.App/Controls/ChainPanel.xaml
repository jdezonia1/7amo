<UserControl x:Class="Raffaello.App.Controls.ChainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <Border Style="{StaticResource Card}" Padding="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Data="{StaticResource IconLink}" Width="15" Height="15" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="The chain" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ContentControl Style="{StaticResource Tag}" Content="{Binding Verdict}" HorizontalAlignment="Right" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" FontSize="22" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SubTitle}" Style="{StaticResource Small}" Margin="0,0,0,10"/>

                <ItemsControl ItemsSource="{Binding Links}" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Rectangle x:Name="Connector" Width="2" Fill="{DynamicResource LineBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Top" Margin="0,4,0,0" BorderThickness="3"
                                        BorderBrush="{Binding Status, Converter={StaticResource StatusStripe}}" Background="{DynamicResource SurfaceBrush}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,12">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource NumTotal}" FontSize="17" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding Pct, Mode=OneWay}" Margin="0,4,0,4" Height="4"
                                                 Foreground="{Binding Status, Converter={StaticResource StatusStripe}}"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                    <Setter TargetName="Connector" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ContentControl Style="{StaticResource HeroCard}" Margin="0,4,0,10" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Certifiable now" FontFamily="{StaticResource FontSansSemi}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="{Binding Certifiable}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="26" Foreground="{DynamicResource HeroInkBrush}"/>
                        <TextBlock Text="{Binding CertifiableValue}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource HeroInkBrush}" Opacity="0.75"/>
                        <TextBlock Text="Min(claimed, done by WIR, project QTY)" FontSize="10" Foreground="{DynamicResource HeroInkBrush}" Opacity="0.55" Margin="0,4,0,0"/>
                    </StackPanel>
                </ContentControl>

                <ItemsControl ItemsSource="{Binding Findings}" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Well}" Margin="0,0,0,4" Padding="10,6">
                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,10,0,0" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Project QTY" Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding ProjectQtyText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Site %" Style="{StaticResource Label}" FontSize="10" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding SitePctText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding HasRow, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnGhost}" Content="Save line" Command="{Binding SaveEditsCommand}"/>
                    <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Command="{Binding AskCommand}">
                        <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconSparkles}" Width="15" Height="15" Foreground="{DynamicResource OnAccentBrush}"/><TextBlock Text="Ask" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
