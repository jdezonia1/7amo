<UserControl x:Class="Raffaello.App.Views.Trust.TrustView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [trust] TRUST & INTEGRATIONS: integrity, signatures, E-Promise, CAD exchange, portal inbox, Aconex API -->
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab, Mode=TwoWay}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Width="120" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Label}"/>
            </StackPanel>
        </Grid>

        <!-- INTEGRITY -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding IsIntegrity, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="TAMPER-EVIDENT AUDIT LOG" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Every audit row is sealed with SHA-256(previous seal + row). The check recomputes the whole chain and reports any edited, deleted or re-linked row; heads seen before are kept on this PC (anchors) so a rewritten history is caught too."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Style="{StaticResource BtnPrimary}" Content="VERIFY INTEGRITY" Command="{Binding VerifyIntegrityCommand}"/>
                        <CheckBox Content="independent check (download the chain - server mode)" IsChecked="{Binding Independent}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource BtnLink}" Content="SAVE REPORT" Command="{Binding SaveIntegrityReportCommand}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding IntegritySummary}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding IntegrityProblems}"/>
            </DockPanel>
        </Border>

        <!-- SIGNATURES -->
        <Grid Grid.Row="1" Visibility="{Binding IsSignatures, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="APPROVALS / SIGN-OFF" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding KeyText}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Signables}" SelectedItem="{Binding SelectedSignable, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Purposes}" SelectedItem="{Binding Purpose, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}" Content="SIGN" Command="{Binding SignCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="SIGN WITH PACKAGE" Command="{Binding SignPackageCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="VERIFY" Command="{Binding VerifySelectedCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding Signatures}" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATUS" Width="64">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="VERDICT" Binding="{Binding Verdict}" Width="90" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="PURPOSE" Binding="{Binding Purpose}" Width="90" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="SIGNER" Binding="{Binding Signer}" Width="180" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="SIGNED" Binding="{Binding SignedAt, StringFormat=dd MMM yy HH:mm}" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="KEY" Binding="{Binding Key}" Width="140" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnGhost}" Content="SIGNED PDF COPY" Command="{Binding SignedPdfCopyCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="VERIFY PDF" Command="{Binding VerifyPdfCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="VERIFY PACKAGE ZIP" Command="{Binding VerifyPackageZipCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PdfCheckText}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Signatures are internal approvals (self-issued keys). A legally qualified e-signature needs a company certificate from an accredited CA - see docs/TRUST.md."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- E-PROMISE -->
        <Grid Grid.Row="1" Visibility="{Binding IsEPromise, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="E-PROMISE (ERP) EXPORT - CERTIFIED INVOICE" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding EpInvoice, Mode=TwoWay}" DisplayMemberPath="Title" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox Content="export even if not certified" IsChecked="{Binding EpForce}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="EXCEL" Command="{Binding ExportEPromiseCommand}" CommandParameter="XLSX" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="CSV" Command="{Binding ExportEPromiseCommand}" CommandParameter="CSV" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnLink}" Content="COLUMN MAPPING" Command="{Binding OpenEPromiseMappingCommand}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding EpSummary}" Style="{StaticResource BodyStrong}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding EPromiseRows}" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="170" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="COST CODE" Binding="{Binding CostCode}" Width="100" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="BUDGET RES." Binding="{Binding BudgetResourceCode}" Width="100" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="100" ElementStyle="{StaticResource CellNumStrong}"/>
                </DataGrid.Columns>
            </DataGrid>
            <ListBox Grid.Row="2" Style="{StaticResource CardList}" ItemsSource="{Binding EPromiseIssues}" MaxHeight="120" Margin="0,10,0,0"/>
        </Grid>

        <!-- CAD EXCHANGE -->
        <Grid Grid.Row="1" Visibility="{Binding IsCad, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="CAD EXCHANGE - ROOMS AND COUNTS FROM AUTOCAD / REVIT" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="STAGES" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding CadStages, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding CadModes}" SelectedItem="{Binding CadMode, Mode=TwoWay}" Width="130" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="OPEN .JSON" Command="{Binding OpenCadFileCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="IMPORT" Command="{Binding ImportCadCommand}" IsEnabled="{Binding CadCanImport}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnLink}" Content="SAVE SCHEMA + BLOCK MAP" Command="{Binding SaveCadSchemaCommand}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CadSummary}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding CadChanges}" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="70" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="ROOM" Binding="{Binding Room}" Width="100" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="90" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding Item}" Width="120" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="NOW" Binding="{Binding OldQty, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CAD" Binding="{Binding NewQty, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <ListBox Grid.Row="2" Style="{StaticResource CardList}" ItemsSource="{Binding CadMessages}" MaxHeight="120" Margin="0,10,0,0"/>
        </Grid>

        <!-- PORTAL INBOX -->
        <Grid Grid.Row="1" Visibility="{Binding IsPortal, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="The subcontractor portal needs the Raffaello server (Settings > Data source)." Style="{StaticResource BodyStrong}"
                       Visibility="{Binding IsServerMode, Converter={StaticResource InverseBoolToVis}}"/>
            <Grid Visibility="{Binding IsServerMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox Content="open only" IsChecked="{Binding OpenOnly}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BtnLink}" Content="REFRESH" Command="{Binding RefreshPortalCommand}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BtnLink}" Content="OPEN PORTAL PAGE" Command="{Binding OpenPortalPageCommand}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding PortalSubmissions}" SelectedItem="{Binding SelectedSubmission, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="SUB" Binding="{Binding Company}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="STATEMENT" Binding="{Binding StatementNo}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="SENT" Binding="{Binding SubmittedAt, StringFormat=dd MMM HH:mm}" Width="80" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="COMPANIES / ACCOUNTS" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBox Text="{Binding NewCompany, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="Company (ledger name)" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding NewCompanyScope, UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Room scope e.g. P2-*,P3-1??" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource BtnLink}" Content="ADD COMPANY" Command="{Binding AddCompanyCommand}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding NewAccountUser, UpdateSourceTrigger=PropertyChanged}" Width="110" ToolTip="Portal user name" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding NewAccountPassword, UpdateSourceTrigger=PropertyChanged}" Width="120" ToolTip="Initial password (10+ letters and digits)" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource BtnLink}" Content="ADD ACCOUNT" Command="{Binding AddAccountCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding PortalAccounts.Count, StringFormat={}{0} portal account(s)}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSubmission.Note}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedSubmission.Findings}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding PortalFiles}" Margin="0,4,0,4">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Small}" Text="{Binding FileName}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnGhost}" Content="OPEN FILES" Command="{Binding OpenSubmissionFilesCommand}" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource BtnGhost}" Content="PREVIEW STATEMENT" Command="{Binding PreviewSubmissionCommand}" Margin="0,0,6,0"/>
                                <TextBlock Text="INVOICE NO" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Text="{Binding PortalInvoiceNo, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PortalPreviewText}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding PortalPreview}" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="60" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="ROOM" Binding="{Binding Line.Room}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Line.Stage}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Line.Item}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Line.Qty, StringFormat=N2}" Width="60" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Check.Message}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PortalOverReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Over reason (posts OVER lines at full qty; empty = skip them)" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="POST TO LEDGER" Command="{Binding ImportSubmissionCommand}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PortalReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rejection reason (the subcontractor sees it)" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="REJECT" Command="{Binding RejectSubmissionCommand}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PortalMessage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Message to the subcontractor" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="SEND MESSAGE" Command="{Binding SendPortalMessageCommand}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding PortalMessages}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap">
                                        <Run Text="{Binding Direction, Mode=OneWay}"/> <Run Text="{Binding From, Mode=OneWay}"/>: <Run Text="{Binding Body, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ACONEX API -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Visibility="{Binding IsAconex, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="ORACLE ACONEX REST API" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="When MOBCO obtains API credentials (integration registered with Oracle: application key + OAuth client), set Enabled: true in aconex-api.json; the ACONEX page then uses the API instead of the browser for workflow lookups and register downloads."/>
                <TextBlock Text="{Binding AconexApiStatus}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnGhost}" Content="OPEN CONFIG" Command="{Binding OpenAconexApiConfigCommand}" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding AconexSecret, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="Client secret / token / password" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="STORE SECRET (DPAPI)" Command="{Binding SaveAconexSecretCommand}" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="TEST CONNECTION" Command="{Binding TestAconexApiCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
