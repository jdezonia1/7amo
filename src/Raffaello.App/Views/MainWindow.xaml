<Window x:Class="Raffaello.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Raffaello.App.Controls"
        xmlns:vm="clr-namespace:Raffaello.App.ViewModels"
        xmlns:pages="clr-namespace:Raffaello.App.Views.Pages"
        xmlns:p5="clr-namespace:Raffaello.App.Services.Phase5"
        xmlns:ivm="clr-namespace:Raffaello.App.ViewModels.Insights"
        xmlns:views="clr-namespace:Raffaello.App.Views"
        xmlns:res="clr-namespace:Raffaello.App.Resources"
        Title="Raffaello" Width="1366" Height="768" MinWidth="1080" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/raffaello.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}"
        FontFamily="{StaticResource FontSans}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><pages:WelcomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><pages:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuantitiesViewModel}"><pages:QuantitiesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatementsViewModel}"><pages:StatementsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaterialsViewModel}"><pages:MaterialsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AconexViewModel}"><pages:AconexView/></DataTemplate>
        <!-- [phase4] begin -->
        <DataTemplate DataType="{x:Type vm:AconexHubViewModel}"><pages:AconexWorkflowsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VariationsViewModel}"><pages:VariationsView/></DataTemplate>
        <!-- [phase4] end -->
        <DataTemplate DataType="{x:Type vm:WirViewModel}"><pages:WirView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ContractsViewModel}"><pages:ContractsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoicesViewModel}"><pages:InvoicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}"><pages:ReportsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><pages:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LedgerViewModel}"><pages:LedgerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChecksViewModel}"><pages:ChecksView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SiteStatementsViewModel}"><pages:SiteStatementsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlanViewModel}"><pages:PlanView/></DataTemplate>
        <!-- [phase3] -->
        <DataTemplate DataType="{x:Type vm:MaterialsHubViewModel}"><pages:MaterialsHubView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerMosViewModel}"><pages:OwnerMosView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoqViewModel}"><pages:BoqView/></DataTemplate>
        <!-- [assistant] begin -->
        <DataTemplate DataType="{x:Type vm:AssistantPageViewModel}"><pages:AssistantPageView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BriefViewModel}"><pages:BriefView/></DataTemplate>
        <!-- [assistant] end -->
        <!-- [phase3] end -->
        <!-- [insights] begin -->
        <DataTemplate DataType="{x:Type ivm:InsightsAnomaliesViewModel}"><pages:InsightsAnomaliesView/></DataTemplate>
        <DataTemplate DataType="{x:Type ivm:InsightsReconViewModel}"><pages:InsightsReconView/></DataTemplate>
        <DataTemplate DataType="{x:Type ivm:InsightsRatesViewModel}"><pages:InsightsRatesView/></DataTemplate>
        <DataTemplate DataType="{x:Type ivm:InsightsCashFlowViewModel}"><pages:InsightsCashFlowView/></DataTemplate>
        <DataTemplate DataType="{x:Type ivm:InsightsEarnedValueViewModel}"><pages:InsightsEarnedValueView/></DataTemplate>
        <!-- [insights] end -->
        <!-- [cables] --><DataTemplate DataType="{x:Type vm:CablesViewModel}"><pages:CablesView/></DataTemplate>

        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MaxDropDownHeight" Value="420"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Key="A" Modifiers="Control+Shift" Command="{Binding ToggleAskCommand}"/>
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportFileCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportViewCommand}"/>
        <KeyBinding Key="L" Modifiers="Control+Shift" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}"/>
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding GoWelcomeCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="8"/>
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="9"/>
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding GoIndexCommand}" CommandParameter="0"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ SIDEBAR -->
        <Border Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,6">
                    <Button Command="{Binding GoWelcomeCommand}" Cursor="Hand" Margin="12,0,12,0" ToolTip="Welcome (Ctrl+H)" Background="Transparent" BorderThickness="0" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <c:LogoMark Width="40" Height="40" ShowTile="False"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="RAFFAELLO" Style="{StaticResource Wordmark}"/>
                                <TextBlock Text="Every quantity. One chain." FontSize="10" Foreground="{StaticResource BrandGoldBrush}" FontFamily="{StaticResource FontSans}"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <ComboBox ItemsSource="{Binding Projects}" SelectedIndex="0" Margin="12,14,12,4" Height="34"
                              Background="#221D1D" BorderBrush="#2A2424" Foreground="{StaticResource SidebarInkBrush}" FontSize="11"
                              ToolTip="Project">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource FontDisplay}" FontSize="12"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,12">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" DataContext="{Binding SettingsItem}" IsChecked="{Binding IsActive, Mode=TwoWay}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconSettings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="SETTINGS" Margin="10,0,0,0" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Button Style="{StaticResource BtnYellow}" Command="{Binding ToggleAskCommand}" Margin="12,10,12,0" HorizontalContentAlignment="Left" ToolTip="Ctrl+Shift+A">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Data="{StaticResource IconSparkles}" Foreground="{DynamicResource OnYellowBrush}"/>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="ASK RAFFAELLO" FontSize="14"/>
                                <TextBlock Text="CTRL+SHIFT+A" FontSize="9" Opacity="0.7" FontFamily="{StaticResource FontSans}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Grid Margin="14,14,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="{Binding UserInitials}" Foreground="White" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="{StaticResource SidebarInkBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Presence.OthersOnline}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding Presence.OthersOnline}"/>
                            <!-- [phase5] begin: data source / sync status -->
                            <TextBlock Text="{Binding Source={x:Static p5:SyncStatus.Current}, Path=Text}" ToolTip="{Binding Source={x:Static p5:SyncStatus.Current}, Path=Detail}"
                                       Foreground="{StaticResource SidebarMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                            <!-- [phase5] end -->
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,0">
                                    <!-- [assistant] translated group --><TextBlock Margin="22,4,0,4" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SidebarMutedBrush}" FontFamily="{StaticResource FontSansSemi}"><TextBlock.Text><MultiBinding Converter="{x:Static res:TrConverter.Instance}"><Binding Path="Title"/><Binding Source="{x:Static res:LocService.Instance}" Path="Version"/></MultiBinding></TextBlock.Text></TextBlock>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="{Binding IsActive, Mode=TwoWay}" ToolTip="{Binding Shortcut}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <c:IconView Data="{Binding Icon, Converter={x:Static c:ResourceKeyConverter.Instance}}"
                                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                                        <!-- [assistant] translated label --><TextBlock Grid.Column="1" Margin="10,0,0,0" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"><TextBlock.Text><MultiBinding Converter="{x:Static res:TrConverter.Instance}"><Binding Path="Label"/><Binding Source="{x:Static res:LocService.Instance}" Path="Version"/></MultiBinding></TextBlock.Text></TextBlock>
                                                        <Border Grid.Column="2" Background="{StaticResource BrandGoldBrush}" CornerRadius="6" Padding="5,0" MinWidth="18"
                                                                Visibility="{Binding Badge, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="#231A00" HorizontalAlignment="Center" FontFamily="{StaticResource FontMonoBold}"/>
                                                        </Border>
                                                    </Grid>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================ MAIN -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="24,16,24,8" Visibility="{Binding IsWelcome, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <!-- [assistant] begin: translated page title / subtitle -->
                    <TextBlock Style="{StaticResource PageTitle}"><TextBlock.Text><MultiBinding Converter="{x:Static res:TrConverter.Instance}"><Binding Path="Current.Title"/><Binding Source="{x:Static res:LocService.Instance}" Path="Version"/></MultiBinding></TextBlock.Text></TextBlock>
                    <TextBlock Style="{StaticResource Small}" Margin="0,1,0,0"><TextBlock.Text><MultiBinding Converter="{x:Static res:TrConverter.Instance}"><Binding Path="Current.Subtitle"/><Binding Source="{x:Static res:LocService.Instance}" Path="Version"/></MultiBinding></TextBlock.Text></TextBlock>
                    <!-- [assistant] end -->
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- [phase6] building switcher: drives every module (ledger, plans, checks, statements, contracts, invoices, reports) -->
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Building shown in every module">
                        <TextBlock Text="BUILDING" Style="{StaticResource Label}" FontSize="9" Margin="2,0,0,2"/>
                        <ComboBox Style="{StaticResource FilterCombo}" MinWidth="110" ItemsSource="{Binding Filter.Buildings}" SelectedItem="{Binding Filter.Building, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Command="{Binding OpenPaletteCommand}" Style="{StaticResource BtnGhost}" Width="250" HorizontalContentAlignment="Stretch" Margin="0,0,10,0" ToolTip="Ctrl+K">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <c:IconView Data="{StaticResource IconSearch}" Width="15" Height="15" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="Search or jump to..." Margin="8,0,0,0" FontFamily="{StaticResource FontSans}" FontWeight="Normal" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{DynamicResource Surface2Brush}" CornerRadius="5" Padding="5,0">
                                <TextBlock Text="CTRL K" FontSize="10" FontFamily="{StaticResource FontMono}" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource BtnYellow}" Command="{Binding ImportFileCommand}" Margin="0,0,8,0" ToolTip="Import Excel / CSV (Ctrl+I)">
                        <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconImport}" Width="15" Height="15" Foreground="{DynamicResource OnYellowBrush}"/><TextBlock Text="IMPORT" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnYellow}" Command="{Binding ExportViewCommand}" Margin="0,0,8,0" ToolTip="Export current view to Excel (Ctrl+E)">
                        <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconExport}" Width="15" Height="15" Foreground="{DynamicResource OnYellowBrush}"/><TextBlock Text="EXPORT" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" Command="{Binding ReloadCommand}" ToolTip="Reload shared data (F5)">
                        <c:IconView Data="{StaticResource IconRefresh}" Foreground="{DynamicResource Ink2Brush}"/>
                    </Button>
                    <Button Style="{StaticResource BtnIcon}" Command="{Binding ToggleThemeCommand}" ToolTip="Light / dark (Ctrl+Shift+L)">
                        <c:IconView Data="{StaticResource IconMoon}" Foreground="{DynamicResource Ink2Brush}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- shared filter bar -->
            <Border Grid.Row="1" Margin="24,0,24,10" Style="{StaticResource Card}" Padding="12,8"
                    Visibility="{Binding Current.ShowFilterBar, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <c:IconView Data="{StaticResource IconFilter}" Width="15" Height="15" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="FILTER" Style="{StaticResource Label}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,0"><TextBlock Text="BUILDING" Style="{StaticResource Label}" FontSize="9" Margin="2,0,0,2"/>
                            <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding Filter.Buildings}" SelectedItem="{Binding Filter.Building, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="LEVEL" Style="{StaticResource Label}" FontSize="9" Margin="2,0,0,2"/>
                            <ComboBox Style="{StaticResource FilterCombo}" MinWidth="80" ItemsSource="{Binding Filter.Levels}" SelectedItem="{Binding Filter.Level, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="ROOM" Style="{StaticResource Label}" FontSize="9" Margin="2,0,0,2"/>
                            <ComboBox Style="{StaticResource FilterCombo}" MinWidth="120" ItemsSource="{Binding Filter.Rooms}" SelectedItem="{Binding Filter.Room, Mode=TwoWay}" IsTextSearchEnabled="True"/></StackPanel>
                        <StackPanel><TextBlock Text="SYSTEM" Style="{StaticResource Label}" FontSize="9" Margin="2,0,0,2"/>
                            <ComboBox Style="{StaticResource FilterCombo}" MinWidth="130" ItemsSource="{Binding Filter.Systems}" SelectedItem="{Binding Filter.System, Mode=TwoWay}"/></StackPanel>
                        <StackPanel><TextBlock Text="STAGE" Style="{StaticResource Label}" FontSize="9" Margin="2,0,0,2"/>
                            <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding Filter.Stages}" SelectedItem="{Binding Filter.Stage, Mode=TwoWay}"/></StackPanel>
                    </WrapPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Command="{Binding ClearFilterCommand}" VerticalAlignment="Bottom"
                            Visibility="{Binding Filter.IsFiltered, Converter={StaticResource BoolToVis}}" Content="CLEAR"/>
                </Grid>
            </Border>

            <ContentControl Grid.Row="2" Content="{Binding Current}" Focusable="False"/>
        </Grid>

        <!-- ============================================================ ASK PANEL -->
        <!-- [assistant] begin: the chat lives in Views/AssistantPanel.xaml (also hosted by the ASK RAFFAELLO page) -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding Ask.IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource OverlayBrush}" Opacity="0.35" MouseDown="AskBackdrop_MouseDown"/>
            <Border Width="480" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <Border.RenderTransform><TranslateTransform x:Name="AskSlide"/></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="480" To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <views:AssistantPanel DataContext="{Binding Ask}"/>
            </Border>
        </Grid>
        <!-- [assistant] end -->

        <!-- ============================================================ COMMAND PALETTE -->
        <Grid Grid.ColumnSpan="2" Visibility="{Binding Palette.IsOpen, Converter={StaticResource BoolToVis}}" DataContext="{Binding Palette}">
            <Border Background="{DynamicResource OverlayBrush}" MouseDown="PaletteBackdrop_MouseDown"/>
            <Border Width="660" VerticalAlignment="Top" Margin="0,80,0,0" Style="{StaticResource Card}" Padding="10" MaxHeight="520">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBox x:Name="PaletteInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="36,9,10,9" PreviewKeyDown="PaletteInput_PreviewKeyDown"/>
                        <c:IconView Data="{StaticResource IconSearch}" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="6,8,0,0" FontSize="11"
                               Text="UP / DOWN to move  |  ENTER to open  |  ESC to close  |  type a room, WIR, invoice, PO or a line like  L2 201 LIGHT"/>
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}" Style="{StaticResource CardList}" Margin="0,10,0,0"
                             MouseDoubleClick="PaletteList_MouseDoubleClick" MouseLeftButtonUp="PaletteList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource Tag}" Content="{Binding Group}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================================================ TOASTS -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" Width="360" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource SidebarBrush}" CornerRadius="12" Margin="0,8,0,0" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border CornerRadius="2" Background="{Binding Status, Converter={StaticResource StatusStripe}}"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource SidebarInkBrush}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding Message, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
