<UserControl x:Class="Raffaello.App.Views.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:res="clr-namespace:Raffaello.App.Resources"
             Background="{DynamicResource SurfaceBrush}">
    <!-- [assistant] Ask Raffaello chat: used by the slide-in panel (Ctrl+Shift+A) and the full ASK RAFFAELLO page. DataContext = AskViewModel. -->
    <Grid>
        <DockPanel>
            <!-- header -->
            <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:IconView Data="{StaticResource IconSparkles}" Foreground="{StaticResource BrandGoldBrush}" Width="20" Height="20"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{res:L Ask_Title}" Style="{StaticResource Wordmark}" FontSize="18"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrandGoldBrush}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{DynamicResource GoodBrush}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ModeText}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource BtnIcon}" Command="{Binding ToggleHistoryCommand}" ToolTip="{res:L Ask_Conversations}">
                        <c:IconView Data="{StaticResource IconClock}" Foreground="{StaticResource SidebarInkBrush}" Width="15" Height="15"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource BtnIcon}" Command="{Binding NewConversationCommand}" ToolTip="{res:L Btn_NewConversation}">
                        <c:IconView Data="{StaticResource IconRefresh}" Foreground="{StaticResource SidebarInkBrush}" Width="15" Height="15"/>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource BtnIcon}" Command="{Binding OpenFullPageCommand}" ToolTip="{res:L Btn_OpenFullPage}"
                            Visibility="{Binding IsPageMode, Converter={StaticResource InverseBoolToVis}}">
                        <c:IconView Data="{StaticResource IconArrowRight}" Foreground="{StaticResource SidebarInkBrush}" Width="15" Height="15"/>
                    </Button>
                    <Button Grid.Column="5" Style="{StaticResource BtnIcon}" Command="{Binding CloseCommand}" ToolTip="Close (Esc)"
                            Visibility="{Binding IsPageMode, Converter={StaticResource InverseBoolToVis}}">
                        <c:IconView Data="{StaticResource IconClose}" Foreground="{StaticResource SidebarInkBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- context strip -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface2Brush}" Padding="16,7">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Data="{StaticResource IconLink}" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding ContextText}" Margin="8,0,0,0" FontSize="11" FontFamily="{StaticResource FontSansSemi}" Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                </StackPanel>
            </Border>

            <!-- input -->
            <Border DockPanel.Dock="Bottom" Padding="12,10,12,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Suggestions}" Margin="0,0,0,6" Visibility="{Binding Messages.Count, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnGhost}" Content="{Binding}" FontFamily="{StaticResource FontSans}" FontWeight="Normal" FontSize="11" Padding="8,3" Margin="0,0,6,6"
                                        Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource YellowSoftBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource InkBrush}" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource BtnIcon}" Padding="2" Margin="4,0,0,0" ToolTip="{res:L Btn_Remove}"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <c:IconView Data="{StaticResource IconClose}" Width="10" Height="10" Foreground="{DynamicResource Ink2Brush}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnGhost}" Command="{Binding AttachCommand}" Padding="9,8" Margin="0,0,8,0" ToolTip="{res:L Btn_Attach}" VerticalAlignment="Bottom">
                            <c:IconView Data="{StaticResource IconImport}" Foreground="{DynamicResource Ink2Brush}" Width="15" Height="15"/>
                        </Button>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="Input" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" PreviewKeyDown="Input_PreviewKeyDown" SpellCheck.IsEnabled="False"/>
                            <TextBlock Text="{res:L Ask_Placeholder}" Style="{StaticResource Small}" FontSize="11" Margin="10,10,10,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding Input, Converter={StaticResource InverseBoolToVis}}"/>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Command="{Binding SendCommand}" Margin="8,0,0,0" Padding="12,8" VerticalAlignment="Bottom" ToolTip="{res:L Btn_Send}"
                                Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                            <c:IconView Data="{StaticResource IconSend}" Foreground="{DynamicResource OnAccentBrush}" Width="16" Height="16"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Command="{Binding StopCommand}" Margin="8,0,0,0" Padding="12,8" VerticalAlignment="Bottom" ToolTip="{res:L Btn_Stop}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <c:IconView Data="{StaticResource IconStop}" Foreground="{DynamicResource AccentBrush}" Width="16" Height="16"/>
                        </Button>
                    </Grid>
                    <!-- privacy indicator: what leaves this PC -->
                    <StackPanel Orientation="Horizontal" Margin="2,6,0,0" ToolTip="{Binding PrivacyText}">
                        <c:IconView Data="{StaticResource IconAlert}" Width="11" Height="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Margin="5,0,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxWidth="560">
                            <Run Text="{res:L Ask_Privacy}" FontWeight="Bold"/><Run Text=": "/><Run Text="{Binding PrivacyText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- conversation -->
            <ScrollViewer x:Name="Scroll" Padding="14,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Small}" Margin="2,0,2,10" TextWrapping="Wrap" Text="{res:L Ask_Empty}"
                               Visibility="{Binding Messages.Count, Converter={StaticResource InverseBoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <Border x:Name="Bubble" CornerRadius="12" Padding="12,9" Margin="40,0,0,0" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right">
                                        <StackPanel>
                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                                                     FontFamily="{StaticResource FontSans}" FontSize="13" Foreground="{DynamicResource InkBrush}" FlowDirection="{Binding Direction}"
                                                     Visibility="{Binding Text, Converter={StaticResource BoolToVis}}">
                                                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></TextBox.Template>
                                            </TextBox>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding Activity, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                                                <c:IconView Data="{StaticResource IconClock}" Width="12" Height="12" Foreground="{DynamicResource MutedBrush}"/>
                                                <TextBlock Text="{Binding Activity}" Style="{StaticResource Small}" FontSize="11" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <!-- sources -->
                                            <StackPanel Visibility="{Binding Citations.Count, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                                <TextBlock Text="{res:L Ask_Sources}" Style="{StaticResource Label}" FontSize="9" Margin="0,0,0,3"/>
                                                <ItemsControl ItemsSource="{Binding Citations}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource BtnGhost}" Padding="7,2" Margin="0,0,5,5" FontSize="10" FontFamily="{StaticResource FontMono}" FontWeight="Normal"
                                                                    Content="{Binding Label}" ToolTip="{Binding Token}"
                                                                    Command="{Binding DataContext.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <!-- cards: proposed writes, run only on CONFIRM -->
                                            <ItemsControl ItemsSource="{Binding Cards}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,8,0,0" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}"/>
                                                                        <TextBlock Text="{res:L Ask_ActionCard}" Style="{StaticResource Label}" FontSize="9" Visibility="{Binding CanDecide, Converter={StaticResource BoolToVis}}"/>
                                                                    </StackPanel>
                                                                    <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding StatusTag}" VerticalAlignment="Top"/>
                                                                </Grid>
                                                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource InkBrush}"/>
                                                                <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource AccentBrush}"
                                                                           Visibility="{Binding Warnings, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"
                                                                           Visibility="{Binding Result, Converter={StaticResource BoolToVis}}"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CanDecide, Converter={StaticResource BoolToVis}}">
                                                                    <Button Style="{StaticResource BtnPrimary}" Content="{res:L Btn_Confirm}" Padding="14,6" Margin="0,0,8,0"
                                                                            Command="{Binding DataContext.ConfirmActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                    <Button Style="{StaticResource BtnGhost}" Content="{res:L Btn_Cancel}" Padding="14,6"
                                                                            Command="{Binding DataContext.CancelActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                                <Button Style="{StaticResource BtnLink}" Content="{res:L Btn_Open}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                        Visibility="{Binding ResultRef, Converter={StaticResource BoolToVis}}"
                                                                        Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="OfflineMark" Text="OFFLINE" Style="{StaticResource Label}" FontSize="9" Margin="4,2,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="False">
                                        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter TargetName="Bubble" Property="Margin" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Offline}" Value="True">
                                        <Setter TargetName="OfflineMark" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- conversation history drawer -->
        <Border Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}" Background="{DynamicResource SurfaceBrush}" Margin="0,62,0,0"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,10">
                <TextBlock DockPanel.Dock="Top" Text="{res:L Ask_Conversations}" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Conversations}" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnLink}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.OpenConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastAt, StringFormat=dd MMM yyyy HH:mm}" Style="{StaticResource Small}" FontSize="10"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource BtnIcon}" ToolTip="{res:L Btn_Delete}"
                                        Command="{Binding DataContext.ArchiveConversationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <c:IconView Data="{StaticResource IconClose}" Width="11" Height="11" Foreground="{DynamicResource MutedBrush}"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
