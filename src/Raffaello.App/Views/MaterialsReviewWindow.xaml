<Window x:Class="Raffaello.App.Views.MaterialsReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1340" Height="820" WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/raffaello.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource FontSans}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Page on the left, what was read on the right. Fix any value in place, RE-CHECK runs qty x rate, totals, sub-totals and unit conversions again. Nothing is saved until ACCEPT." Style="{StaticResource Small}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- page -->
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" DisplayMemberPath="Caption"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="-" Command="{Binding ZoomOutCommand}" Width="34"/>
                            <Button Style="{StaticResource BtnGhost}" Content="+" Command="{Binding ZoomInCommand}" Width="34" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding PageImage}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="900">
                                <Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="{Binding PageText}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Ink2Brush}"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- extracted -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="10">
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="190" Margin="0,0,8,6" ToolTip="{Binding Issue}">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"/>
                                    <TextBlock Text="{Binding Issue}" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <Grid Grid.Row="1" Margin="0,8,0,6">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnGhost}" Content="Add row" Command="{Binding AddRowCommand}"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Remove row" Command="{Binding RemoveRowCommand}" Margin="6,0,0,0"/>
                        <Button Style="{StaticResource BtnYellow}" Content="Re-check" Command="{Binding RecheckCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" IsReadOnly="False" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          Visibility="{Binding IsPo, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CHECK" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Tag}" ToolTip="{Binding Issue}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="NO" Binding="{Binding LineNo}" Width="44"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="50"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N3}" Width="80"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="QTY x RATE" Binding="{Binding Check, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ISSUE" Binding="{Binding Issue}" Width="160" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" IsReadOnly="False" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          Visibility="{Binding IsDn, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CHECK" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Tag}" ToolTip="{Binding Issue}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding ItemNo}" Width="64"/>
                        <DataGridTextColumn Header="CODE" Binding="{Binding ItemCode}" Width="80"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="180"/>
                        <DataGridTextColumn Header="BATCH / DRUM" Binding="{Binding Batch}" Width="100"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding RawQty}" Width="64"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding RawUnit}" Width="44"/>
                        <DataGridTextColumn Header="= QTY" Binding="{Binding Qty, StringFormat=N2}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44" IsReadOnly="True"/>
                        <DataGridTextColumn Header="READ AS" Binding="{Binding Spec}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="ISSUE" Binding="{Binding Issue}" Width="140" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" IsReadOnly="False" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          Visibility="{Binding IsMir, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="80"/>
                        <DataGridTextColumn Header="PAGE" Binding="{Binding Page}" Width="50"/>
                        <DataGridTextColumn Header="DN" Binding="{Binding DnNo}" Width="80"/>
                        <DataGridTextColumn Header="DRUM" Binding="{Binding DrumNo}" Width="80"/>
                        <DataGridTextColumn Header="BATCH" Binding="{Binding Batch}" Width="100"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="160"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Qty}" Width="70"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44"/>
                        <DataGridTextColumn Header="PO REF" Binding="{Binding PoRef}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10" Margin="0,8,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Checks" Style="{StaticResource PanelTitle}" Margin="0,0,0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Issues}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <ContentControl Style="{StaticResource Tag}" Content="{Binding Status}" Width="56"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Small}" Margin="6,0,0,0" TextWrapping="Wrap" MaxWidth="620"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <TextBlock Text="Errors do not block saving, but every saved line keeps its source (TEXT / OCR / VISION / MANUAL)." Style="{StaticResource Small}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource BtnPrimary}" Content="Accept and save" Command="{Binding AcceptCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
