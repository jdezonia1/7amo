<UserControl x:Class="Raffaello.App.Views.AssistantSettingsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:res="clr-namespace:Raffaello.App.Resources">
    <!-- [assistant] Settings: language, assistant, morning brief, notification channels and rules. DataContext = AssistantSettingsViewModel. -->
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <c:IconView Data="{StaticResource IconSparkles}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{res:L Set_Assistant}" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{res:L Set_Language}" Style="{StaticResource Label}" FontSize="10"/>
                <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Language, Mode=TwoWay}" Margin="0,3,0,10" Width="220" HorizontalAlignment="Left"/>
                <!-- [claude-login] engine: AUTO / API KEY / CLAUDE LOGIN (Claude Code) / OFFLINE -->
                <TextBlock Text="Provider" Style="{StaticResource Label}" FontSize="10"/>
                <ComboBox ItemsSource="{Binding Providers}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Provider, Mode=TwoWay}" Margin="0,3,0,4" MaxWidth="520" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding RouteText}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Claude login (Claude Code) - no API key needed" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBlock Text="{Binding ClaudeStatusText}" Style="{StaticResource BodyStrong}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"/>
                        <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource BtnGhost}" Content="Check Claude Code" Command="{Binding CheckClaudeCommand}" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource BtnGhost}" Content="Use with Claude Desktop" Command="{Binding ShowDesktopConfigCommand}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="140"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="claude.exe (empty = find it)" Style="{StaticResource Label}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBox Text="{Binding ClaudeCodePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,6"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Model (empty = default)" Style="{StaticResource Label}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBox Text="{Binding ClaudeCodeModel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,6"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Time limit (s)" Style="{StaticResource Label}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBox Text="{Binding ClaudeTimeout, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,6"/></StackPanel>
                        </Grid>
                        <StackPanel Visibility="{Binding ShowDesktop, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Text="Claude Desktop: add this to claude_desktop_config.json (the app does not edit it)" Style="{StaticResource Label}" FontSize="9" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding DesktopSnippet, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     FontFamily="{StaticResource FontMono}" FontSize="11" MaxHeight="200" Margin="0,3,0,6"/>
                            <Button Style="{StaticResource BtnGhost}" Content="Copy" Command="{Binding CopyDesktopConfigCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding DesktopInstructions}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource BodyStrong}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <TextBlock Text="{res:L Set_ApiKey}" Style="{StaticResource Label}" FontSize="10"/>
                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,10"/>
                <TextBlock Text="{res:L Set_Model}" Style="{StaticResource Label}" FontSize="10"/>
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,10"/>
                <TextBlock Text="{res:L Set_MaxTokens}" Style="{StaticResource Label}" FontSize="10"/>
                <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,10" Width="120" HorizontalAlignment="Left"/>
                <CheckBox Content="{res:L Set_AllowRead}" IsChecked="{Binding AllowRead}" Margin="0,0,0,2"/>
                <TextBlock Text="{res:L Set_AllowReadHint}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,8"/>
                <CheckBox Content="{res:L Set_CloudReading}" IsChecked="{Binding CloudReading}" Margin="0,0,0,10"/>

                <TextBlock Text="{res:L Brief_Title}" Style="{StaticResource PanelTitle}" Margin="0,8,0,8"/>
                <CheckBox Content="{res:L Brief_ShowFirst}" IsChecked="{Binding ShowBriefFirst}" Margin="0,0,0,6"/>
                <CheckBox Content="{res:L Brief_ClaudeSummary}" IsChecked="{Binding BriefClaudeSummary}" Margin="0,0,0,6"/>
                <TextBlock Text="{res:L Brief_Time}" Style="{StaticResource Label}" FontSize="10"/>
                <TextBox Text="{Binding BriefTime, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" Width="90" HorizontalAlignment="Left" Margin="0,3,0,4"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{res:L Set_Notifications}" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                <WrapPanel Margin="0,0,0,8">
                    <CheckBox Content="{res:L Set_InAppToasts}" IsChecked="{Binding InAppToasts}" Margin="0,0,16,0"/>
                    <CheckBox Content="{res:L Set_WindowsToasts}" IsChecked="{Binding WindowsToasts}"/>
                </WrapPanel>

                <TextBlock Text="{res:L Set_Email}" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{res:L Set_SmtpHost}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{res:L Set_SmtpPort}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                </Grid>
                <CheckBox Content="{res:L Set_SmtpSsl}" IsChecked="{Binding SmtpSsl}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{res:L Set_SmtpUser}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding SmtpUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{res:L Set_SmtpPassword}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding SmtpPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{res:L Set_SmtpFrom}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding SmtpFrom, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{res:L Set_EmailTo}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding EmailTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                </Grid>
                <TextBlock Text="{res:L Set_Teams}" Style="{StaticResource Label}" FontSize="9" Margin="0,6,0,0"/>
                <TextBox Text="{Binding TeamsUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,6"/>
                <TextBlock Text="{res:L Set_WhatsApp}" Style="{StaticResource Label}" FontSize="9"/>
                <TextBox Text="{Binding WhatsAppUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{res:L Set_WhatsAppTo}" Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding WhatsAppTo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{res:L Set_WhatsAppHeader}" Style="{StaticResource Label}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBox Text="{Binding WhatsAppHeaderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text=" " Style="{StaticResource Label}" FontSize="9"/><TextBox Text="{Binding WhatsAppHeaderValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/></StackPanel>
                </Grid>
                <TextBlock Text="{res:L Set_WhatsAppTemplate}" Style="{StaticResource Label}" FontSize="9"/>
                <TextBox Text="{Binding WhatsAppTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,6"/>
                <TextBlock Text="{Binding SecretsStatus}" Style="{StaticResource Small}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="{res:L Set_Rules}" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          MaxHeight="260" GridLinesVisibility="Horizontal" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Header="ON" Width="38"/>
                        <DataGridTemplateColumn Header="{res:L Set_Event}" Width="140">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EventKind}" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Events, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding EventKind, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{res:L Set_Channel}" Width="90">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Channel}" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ChannelCodes, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding Channel, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{res:L Set_MinSeverity}" Width="80">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MinSeverity}" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate><DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Severities, RelativeSource={RelativeSource AncestorType=DataGrid}}" SelectedItem="{Binding MinSeverity, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding QuietFrom, UpdateSourceTrigger=PropertyChanged}" Header="{res:L Set_QuietFrom}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding QuietTo, UpdateSourceTrigger=PropertyChanged}" Header="{res:L Set_QuietTo}" Width="70"/>
                        <DataGridTextColumn Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Header="ADDRESS" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource BtnGhost}" Content="{res:L Set_AddRule}" Command="{Binding AddRuleCommand}" Margin="0,0,8,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="{res:L Btn_Remove}" Command="{Binding RemoveRuleCommand}" Margin="0,0,16,6"/>
                    <TextBlock Text="{res:L Set_TestChannel}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="In-app" Command="{Binding TestCommand}" CommandParameter="INAPP" Margin="0,0,4,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Windows" Command="{Binding TestCommand}" CommandParameter="WINDOWS" Margin="0,0,4,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="E-mail" Command="{Binding TestCommand}" CommandParameter="EMAIL" Margin="0,0,4,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Teams" Command="{Binding TestCommand}" CommandParameter="TEAMS" Margin="0,0,4,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Whatsapp" Command="{Binding TestCommand}" CommandParameter="WHATSAPP" Margin="0,0,4,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding TestResult}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap"/>
                <Button Style="{StaticResource BtnPrimary}" Content="{res:L Set_SaveAssistant}" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="18,8"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
