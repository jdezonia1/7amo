<UserControl x:Class="Raffaello.App.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ScopeText}" Style="{StaticResource Label}" Margin="0,0,0,10"/>
                <TextBlock Text="Project reports (room ledger, invoices, materials, variations, ACONEX)" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding ProjectCards}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource BtnYellow}" Content="Excel" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ProjectReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding XlsxParam}"/>
                                        <Button Style="{StaticResource BtnGhost}" Content="PDF"
                                                Command="{Binding DataContext.ProjectReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding PdfParam}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- [insights] begin -->
                <TextBlock Text="Insights (warnings, reconciliation, benchmark, forecasts)" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                <ItemsControl DataContext="{Binding InsightsReports}" ItemsSource="{Binding Cards}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource BtnYellow}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Excel"
                                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- [insights] end -->
                <TextBlock Text="Demo chain reports" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Style="{StaticResource BtnYellow}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Kind}">
                                        <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconExport}" Width="14" Height="14" Foreground="{DynamicResource InkBrush}"/><TextBlock Text="Run" Margin="6,0,0,0"/></StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="This week at a glance" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Summary}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Well}" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource NumTotal}"/>
                                            <ContentControl Grid.Column="2" Style="{StaticResource Tag}" Content="{Binding Status}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="By stage  |  Never summed" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Stages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Well}" Margin="0,0,0,4">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Stage}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                                                <TextBlock Text="{Binding DonePct, StringFormat={}{0:P0} DONE}" Style="{StaticResource NumTotal}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding DonePct, Mode=OneWay}" Margin="0,4,0,4"/>
                                            <TextBlock Style="{StaticResource Num}" TextAlignment="Left" FontSize="11" Foreground="{DynamicResource Ink2Brush}">
                                                <Run Text="QS"/> <Run Text="{Binding Qs, StringFormat=N0, Mode=OneWay}"/>
                                                <Run Text="  Given"/> <Run Text="{Binding Given, StringFormat=N0, Mode=OneWay}"/>
                                                <Run Text="  Done"/> <Run Text="{Binding Done, StringFormat=N0, Mode=OneWay}"/>
                                                <Run Text="  Claimed"/> <Run Text="{Binding Claimed, StringFormat=N0, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
