<UserControl x:Class="Raffaello.App.Views.Pages.InsightsCashFlowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:ivm="clr-namespace:Raffaello.App.ViewModels.Insights"
             xmlns:core="clr-namespace:Raffaello.Core.Insights;assembly=Raffaello.Core">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Views/Pages/InsightsResources.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="520"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="340"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="3" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="PAYABLES (SAR)" Style="{StaticResource Label}"/><TextBlock Text="{Binding TotalPayables, StringFormat=N0}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="OWNER RECEIPTS (SAR)" Style="{StaticResource Label}"/><TextBlock Text="{Binding TotalReceipts, StringFormat=N0}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Style="{StaticResource Label}"><Run Text="LOWEST CUMULATIVE  "/><Run Text="{Binding LowestMonth, Mode=OneWay}"/></TextBlock><TextBlock Text="{Binding LowestCumulative, StringFormat=N0}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="HANDOVER" Style="{StaticResource Label}"/><TextBlock Text="{Binding FinishText}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}" MinWidth="260">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}"><Run Text="SCENARIO: DELAY "/><Run Text="{Binding DelayWeeks, Mode=OneWay}"/><Run Text=" WEEKS"/></TextBlock>
                            <Slider Minimum="0" Maximum="26" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DelayWeeks, Delay=300}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource BtnGhost}" Content="EXPORT EXCEL" Command="{Binding ExportCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="MONTHLY PAYABLES vs RECEIVABLES" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Chart}" XAxes="{Binding ChartX}" YAxes="{Binding ChartY}" LegendPosition="Top" TooltipPosition="Top" Margin="0,6,0,0"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="BY MONTH" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Months}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MONTH" Binding="{Binding Label}" Width="70" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="SUBCONTRACTORS" Binding="{Binding SubPayables, StringFormat=N0}" Width="*" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="SUPPLIERS" Binding="{Binding SupplierPayables, StringFormat=N0}" Width="*" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="OWNER RECEIPTS" Binding="{Binding OwnerReceipts, StringFormat=N0}" Width="*" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="NET" Binding="{Binding Net, StringFormat=N0}" Width="*" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="CUMULATIVE" Binding="{Binding Cumulative, StringFormat=N0}" Width="*" ElementStyle="{StaticResource CellNumStrong}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="ASSUMPTIONS" Style="{StaticResource Label}" Margin="0,12,0,4"/>
                    <ItemsControl ItemsSource="{Binding Assumptions}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='- {0}'}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="PROGRAMME" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Planned start / finish per area (ALL, a level 'Level 01' or a plot 'P2') and stage. Empty table = default spread (1st fix first, 2nd fix middle, final fix last)."/>
                    <DataGrid Style="{StaticResource EditGrid}" ItemsSource="{Binding Programme}" MinHeight="120" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="80"/>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="74"/>
                            <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="62"/>
                            <DataGridTextColumn Header="START" Binding="{Binding PlannedStart, StringFormat=dd-MMM-yyyy}" Width="88"/>
                            <DataGridTextColumn Header="FINISH" Binding="{Binding PlannedFinish, StringFormat=dd-MMM-yyyy}" Width="88"/>
                            <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Style="{StaticResource BtnGhost}" Content="ADD DEFAULT SPREAD" Command="{Binding DefaultProgrammeCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                    <TextBlock Text="PAYMENT TERMS" Style="{StaticResource PanelTitle}" Margin="0,16,0,0"/>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Per contract no. / PO no. ('*' = default for the party). Schemes 90/10, 70/20/10, 100, LC (paid before delivery). Item stage % from the contract wins when it is set."/>
                    <DataGrid Style="{StaticResource EditGrid}" ItemsSource="{Binding Terms}" MinHeight="100" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="PARTY" SelectedItemBinding="{Binding Party}" Width="92"
                                                    ItemsSource="{x:Static ivm:InsightsCashFlowViewModel.PartyOptions}"/>
                            <DataGridTextColumn Header="REF" Binding="{Binding Ref}" Width="100"/>
                            <DataGridComboBoxColumn Header="SCHEME" SelectedItemBinding="{Binding Scheme}" Width="70"
                                                    ItemsSource="{x:Static core:PaymentSchemes.All}"/>
                            <DataGridTextColumn Header="RET." Binding="{Binding RetentionPct}" Width="40"/>
                            <DataGridTextColumn Header="ADV." Binding="{Binding AdvancePct}" Width="40"/>
                            <DataGridTextColumn Header="PAY DAYS" Binding="{Binding PayDays}" Width="54"/>
                            <DataGridTextColumn Header="LC DAYS" Binding="{Binding LcDaysBeforeDelivery}" Width="50"/>
                            <DataGridTextColumn Header="HANDOVER +M" Binding="{Binding HandoverMonths}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Style="{StaticResource BtnGhost}" Content="ADD DEFAULT TERMS" Command="{Binding DefaultTermsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="SAVE" Command="{Binding SaveCommand}" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource BtnYellow}" Content="RECALCULATE" Command="{Binding RecalculateCommand}" Margin="4,0,0,0" ToolTip="Forecast with the tables as edited (before saving)"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
