<UserControl x:Class="Raffaello.App.Views.Pages.SiteStatementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="Chip">
            <ToggleButton Style="{StaticResource ToggleChip}" Content="{Binding Name}" IsChecked="{Binding IsOn, Mode=TwoWay}" Margin="0,0,6,6"/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="ISSUE A STATEMENT" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                    <TextBlock Text="SUBCONTRACTOR" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Subcontractors}" SelectedItem="{Binding Sub, Mode=TwoWay}" Margin="0,2,0,8"/>
                    <TextBlock Text="STATEMENT NO" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding StatementNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                    <TextBlock Text="STAGES" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource Chip}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="SYSTEMS" Style="{StaticResource Label}" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding Systems}" ItemTemplate="{StaticResource Chip}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource BtnPrimary}" Content="GENERATE EXCEL" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="One row per room x stage, one column per system. Remaining quantities are in the cell comments; the sheet is protected except the input cells."/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="HISTORY" Style="{StaticResource PanelTitle}"/>
                        <Button Style="{StaticResource BtnLink}" Content="ATTACH SCAN" Command="{Binding AttachScanCommand}" HorizontalAlignment="Right"/>
                    </Grid>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DIR" Binding="{Binding Direction}" Width="40" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="NO" Binding="{Binding StatementNo}" Width="*" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="SUB" Binding="{Binding Subcontractor}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="LINES" Binding="{Binding Lines}" Width="46" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding At, StringFormat=dd MMM yy}" Width="70" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="POST AS INVOICE NO" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Style="{StaticResource BtnGhost}" Content="OPEN FILLED STATEMENT" Command="{Binding OpenCommand}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="READ SCANNED STATEMENT" Command="{Binding ReadScannedStatementCommand}" Margin="6,0,0,0"
                            ToolTip="Handwritten summary + marked typical-unit drawings, read offline into a DRAFT (pages below). Handwriting is weak offline - check every line."/>
                    <TextBox Text="{Binding ScanPages, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="6,0,0,0" ToolTip="Pages to read, e.g. 1-6"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding PreviewText}" Style="{StaticResource BodyStrong}" VerticalAlignment="Bottom" Margin="14,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding Preview}" VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATUS" Width="64" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ROOM" Binding="{Binding Line.Room}" Width="90" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="STAGE" Binding="{Binding Line.Stage}" Width="90" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding Line.Item}" Width="110" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Line.Qty, StringFormat=N2}" Width="60" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="SITE %" Binding="{Binding Line.SitePct, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="WIR %" Binding="{Binding Line.WirPct, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="WIR NO" Binding="{Binding Line.WirNo}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="CHECKS" Binding="{Binding Checks}" Width="110" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="REMAINING" Binding="{Binding Check.Remaining, StringFormat=N2}" Width="76" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Check.Message}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- cable flags + contract-rule warnings of the preview: never blocking, BYPASS WITH REASON here (audited like the Cables page / invoice WARNINGS tab) -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding WarningsText}" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BypassReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Reason (required, recorded with your name) - e.g. re-pulled after damage, agreed with the engineer"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Content="BYPASS WITH REASON" Command="{Binding BypassWarningCommand}" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="BYPASS ALL OPEN" Command="{Binding BypassAllWarningsCommand}" Margin="6,0,0,0"/>
                    </Grid>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Warnings}" SelectedItem="{Binding SelectedWarning, Mode=TwoWay}" IsReadOnly="True" MaxHeight="170">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="72" SortMemberPath="Tag">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Tag}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="70" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="140" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="LINE" Binding="{Binding Subject}" Width="220" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="WARNING" Binding="{Binding Message}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="DECISION" Binding="{Binding Decision}" Width="180" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Issues}" MaxHeight="110">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="OVER REASON (posts OVER lines at full qty; empty = skip them)" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding OverReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="POST TO LEDGER" Command="{Binding CommitCommand}" VerticalAlignment="Bottom" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
