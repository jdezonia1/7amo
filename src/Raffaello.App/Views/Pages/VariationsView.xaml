<UserControl x:Class="Raffaello.App.Views.Pages.VariationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:var="clr-namespace:Raffaello.Core.Variations;assembly=Raffaello.Core">
    <!-- [phase4] VARIATIONS / EI register and submission editor -->
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- register -->
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <UniformGrid Rows="2" Columns="2" Margin="0,0,0,10">
                <ContentControl Style="{StaticResource HeroCard}" Margin="0,0,6,6">
                    <StackPanel>
                        <TextBlock Text="OPEN" Style="{StaticResource Label}" Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="{Binding KpiOpen}" Style="{StaticResource KpiValue}" FontSize="22" Foreground="{DynamicResource OnAccentBrush}"/>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10">
                    <StackPanel><TextBlock Text="OPEN NET" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding KpiOpenNet}" Style="{StaticResource KpiValue}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="10">
                    <StackPanel><TextBlock Text="APPROVED NET" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding KpiApprovedNet}" Style="{StaticResource KpiValue}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="10">
                    <StackPanel><TextBlock Text="OPEN &gt; 90 DAYS" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding KpiOld}" Style="{StaticResource KpiValue}" FontSize="18" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                </Border>
            </UniformGrid>
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnPrimary}" Content="+ VO" Command="{Binding NewCommand}" CommandParameter="VO"/>
                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="+ EI" Command="{Binding NewCommand}" CommandParameter="EI"/>
                    <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="+ SI" Command="{Binding NewCommand}" CommandParameter="SI"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter, Mode=TwoWay}"/>
                    <TextBox Grid.Column="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Search number, title, consultant ref"/>
                </Grid>
            </StackPanel>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrong}" FontSize="12" TextTrimming="CharacterEllipsis"><Run Text="{Binding Number, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Small}" FontSize="10"/>
                                </StackPanel>
                                <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding Tag}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource BtnYellow}" Content="REGISTER EXCEL" Command="{Binding ExportRegisterCommand}" Margin="0,0,6,0"/>
                <Button Style="{StaticResource BtnGhost}" Content="PDF" Command="{Binding ExportRegisterPdfCommand}"/>
            </StackPanel>
        </Grid>

        <!-- editor -->
        <Grid Grid.Column="2" Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition Width="80"/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="NUMBER" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding Number}" Style="{StaticResource PanelTitle}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="TYPE" Style="{StaticResource Label}" FontSize="10"/><ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type, Mode=TwoWay}" IsEnabled="{Binding IsLocked, Converter={x:Static c:NotConverter.Instance}}"/></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="DATE" Style="{StaticResource Label}" FontSize="10"/><DatePicker SelectedDate="{Binding Date}"/></StackPanel>
                    <StackPanel Grid.Column="6"><TextBlock Text="TITLE" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding VTitle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLocked}"/></StackPanel>
                    <StackPanel Grid.Column="8"><TextBlock Text="STATUS" Style="{StaticResource Label}" FontSize="10"/><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}" Margin="0,4,0,0"/></StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3"><TextBlock Text="CONSULTANT REF" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding ConsultantRef, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLocked}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="4"><TextBlock Text="BUILDING" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding Building, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsLocked}"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="6">
                        <TextBlock Text="ACONEX WORKFLOW (SUBMISSION)" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding AconexWorkflowNo, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnLink}" Content="WHERE IS IT?" Command="{Binding OpenWorkflowCommand}" Margin="6,0,0,0"/></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="8"><TextBlock Text="APPROVED AMOUNT" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding ApprovedAmount, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"/></StackPanel>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="9">
                        <TextBlock Text="DESCRIPTION / CONSULTANT INSTRUCTION" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="54" VerticalScrollBarVisibility="Auto" IsReadOnly="{Binding IsLocked}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnPrimary}" Content="SAVE" Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="+ NEW ITEM" Command="{Binding AddNewItemCommand}" Margin="0,0,6,0"/>
                    <!-- [assemblies] begin -->
                    <Button Style="{StaticResource BtnGhost}" Content="BREAKDOWN" Command="{Binding BreakdownLineCommand}" Margin="0,0,6,0" ToolTip="Rate build-up of the selected line from the BOQ item breakdown (components, quantities, prices)"/>
                    <!-- [assemblies] end -->
                    <Button Style="{StaticResource BtnGhost}" Content="REMOVE LINE" Command="{Binding RemoveLineCommand}" CommandParameter="{Binding SelectedLine}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="SUBMISSION EXCEL" Command="{Binding ExportSubmissionCommand}" CommandParameter="XLSX" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="PDF" Command="{Binding ExportSubmissionCommand}" CommandParameter="PDF" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="DELETE DRAFT" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}"
                      IsReadOnly="{Binding IsLocked}" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridComboBoxColumn Header="KIND" ItemsSource="{x:Static var:VariationLineKinds.All}" SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" Width="96"/>
                    <DataGridTextColumn Header="ITEM CODE" Binding="{Binding ItemCode}" Width="120" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="46" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=0.##}" Width="64" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=0.##}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="MAT." Binding="{Binding Material, StringFormat=0.##}" Width="62" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="LAB." Binding="{Binding Labour, StringFormat=0.##}" Width="62" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="EQP." Binding="{Binding Equipment, StringFormat=0.##}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="OH %" Binding="{Binding OverheadPercent, StringFormat=0.##}" Width="48" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="PROFIT %" Binding="{Binding ProfitPercent, StringFormat=0.##}" Width="58" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="USED RATE" Binding="{Binding EffectiveRate, StringFormat=N2, Mode=OneWay}" Width="74" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N2, Mode=OneWay}" Width="90" IsReadOnly="True" ElementStyle="{StaticResource CellNumStrong}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{StaticResource RadiusCard}" Padding="12,8" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LineWarnings}" Style="{StaticResource Small}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="ADDITIONS" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding AddTotal}" Style="{StaticResource NumTotal}"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="OMISSIONS" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding OmitTotal}" Style="{StaticResource NumTotal}"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="16,0,0,0"><TextBlock Text="NET" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding NetTotal}" Style="{StaticResource NumTotal}" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Column="2" Text="PICK A VARIATION ON THE LEFT, OR CREATE ONE (+ VO / + EI / + SI)" Style="{StaticResource Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasCurrent, Converter={StaticResource InverseBoolToVis}}"/>

        <!-- documents, suggestions, status -->
        <Grid Grid.Column="4" Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <DockPanel Margin="2,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="+ ADD" Command="{Binding AddDocCommand}"/>
                        <TextBlock Text="CONSULTANT DOCUMENTS" Style="{StaticResource PanelTitle}"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Docs}" SelectedItem="{Binding SelectedDoc, Mode=TwoWay}" MaxHeight="110" BorderThickness="0" Background="Transparent" MouseDoubleClick="OnDocDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"><Run Text="{Binding FileName, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding Pages, Mode=OneWay}"/><Run Text=" p, "/><Run Text="{Binding TextStatus, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource BtnLink}" Content="OPEN" Command="{Binding OpenDocCommand}" CommandParameter="{Binding SelectedDoc}" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource BtnLink}" Content="REMOVE" Command="{Binding RemoveDocCommand}" CommandParameter="{Binding SelectedDoc}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Command="{Binding SuggestCommand}">
                            <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconSparkles}" Width="14" Height="14" Foreground="{DynamicResource OnAccentBrush}"/><TextBlock Text="SUGGEST" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <TextBlock Text="RELATED BOQ / CONTRACT ITEMS" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SuggestNote}" Style="{StaticResource Small}" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,6"/>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Suggestions}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrong}" FontSize="11" TextTrimming="CharacterEllipsis"><Run Text="{Binding Source, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Code, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding ScoreText}" Style="{StaticResource BodyStrong}" FontSize="11"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Small}" FontSize="10"><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text="  @ "/><Run Text="{Binding Rate, StringFormat=N2, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Why, Mode=OneWay}"/></TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Button Style="{StaticResource BtnLink}" Content="+ ADDITION" Command="{Binding DataContext.AddAsAdditionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Margin="0,0,10,0"/>
                                        <Button Style="{StaticResource BtnLink}" Content="- OMISSION" Command="{Binding DataContext.AddAsOmissionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource PanelTitle}" Margin="2,0,0,6"/>
                    <TextBox Text="{Binding StatusNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="Note for the status change (consultant comment, reason ...)" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding NextStatuses}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnGhost}" Content="{Binding}" Margin="0,0,6,6"
                                        Command="{Binding DataContext.MoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding StatusLog}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Small}" FontSize="10" TextWrapping="Wrap"><Run Text="{Binding At, StringFormat=dd MMM yy, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding ToStatus, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding By, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Note, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
