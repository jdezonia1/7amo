<UserControl x:Class="Raffaello.App.Views.Pages.ChecksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=TwoWay}"/>
                <ListBox Grid.Column="1" Style="{StaticResource TabStrip}" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope, Mode=TwoWay}" Margin="12,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding Subcontractors}" SelectedItem="{Binding SubFilter, Mode=TwoWay}" ToolTip="Subcontractor"/>
            </Grid>
            <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATUS" Width="76" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SUB" Binding="{Binding Sub}" Width="110" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="INV" Binding="{Binding InvoiceNo}" Width="40" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="ROOM" Binding="{Binding Room}" Width="90" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="90" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding Item}" Width="110" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="60" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CLAIMED" Binding="{Binding Claimed, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="DECIDED" Binding="{Binding Decided, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CHECK" Binding="{Binding CheckStatusText}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="BY" Binding="{Binding CheckedBy}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="15 m rule per subcontractor  |  Claimed vs invoiced (rejected extra is not paid)" Style="{StaticResource Label}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Extras}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SUB" Binding="{Binding Sub}" Width="160" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="LINES" Binding="{Binding Lines}" Width="60" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="CLAIMED" Binding="{Binding Claimed, StringFormat=N1}" Width="90" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="INVOICED" Binding="{Binding Invoiced, StringFormat=N1}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="REJECTED EXTRA" Binding="{Binding RejectedExtra, StringFormat=N1}" Width="*" ElementStyle="{StaticResource CellNum}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource PanelTitle}" Margin="0,0,0,4"><Run Text="Decision  "/><Run Text="{Binding Selected.Room, Mode=OneWay}"/></TextBlock>
                <TextBlock Style="{StaticResource Small}" Margin="0,0,0,10" TextWrapping="Wrap">
                    <Run Text="{Binding Selected.Sub, Mode=OneWay}"/><Run Text="  Inv "/><Run Text="{Binding Selected.InvoiceNo, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding Selected.Stage, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Selected.Item, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Visibility="{Binding IsHeight, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Accepted QTY above 4.5 m (for partly)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding AcceptedQty, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                </StackPanel>
                <StackPanel Visibility="{Binding IsLength, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="GROUPS  (n x length, e.g. 10x20;5x35)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding Groups, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,2,0,8"/>
                    <TextBlock Text="Or total route length (m)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding RouteTotal, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,2,0,8"/>
                    <TextBlock Text="REVISED QTY OVERRIDE (optional)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding RevisedOverride, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,2,0,8"/>
                </StackPanel>
                <TextBlock Text="Note" Style="{StaticResource Label}"/>
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                <Border Style="{StaticResource Well}" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                </Border>
                <UniformGrid Columns="3" Visibility="{Binding IsHeight, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource BtnPrimary}" Content="Accept" Command="{Binding AcceptHeightCommand}" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="Partly" Command="{Binding PartlyHeightCommand}" Margin="2,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Reject" Command="{Binding RejectHeightCommand}" Margin="4,0,0,0"/>
                </UniformGrid>
                <UniformGrid Columns="3" Visibility="{Binding IsLength, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource BtnPrimary}" Content="Accept claim" Command="{Binding AcceptLengthCommand}" Margin="0,0,4,0" ToolTip="Invoice the full claimed 15 m quantity"/>
                    <Button Style="{StaticResource BtnYellow}" Content="Revise" Command="{Binding ReviseLengthCommand}" Margin="2,0" ToolTip="Invoice the revised (or override) quantity"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Reject" Command="{Binding RejectLengthCommand}" Margin="4,0,0,0" ToolTip="Invoice the plan quantity only"/>
                </UniformGrid>
                <Button Style="{StaticResource BtnLink}" Content="Open room in ledger" Command="{Binding OpenRoomCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
