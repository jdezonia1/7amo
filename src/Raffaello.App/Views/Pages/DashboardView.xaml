<UserControl x:Class="Raffaello.App.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="320"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="290"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="290"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="290"/>
            </Grid.RowDefinitions>

            <!-- KPI row -->
            <Grid Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource HeroCard}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="CERTIFIED TO DATE" FontFamily="{StaticResource FontSansSemi}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="{Binding HeroValue}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="32" Foreground="{DynamicResource HeroInkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding HeroDetail}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource HeroInkBrush}" Opacity="0.7" TextWrapping="Wrap"/>
                    </StackPanel>
                </ContentControl>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Kpis}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,0,44,0"/>
                                        <ContentControl Style="{StaticResource Tag}" Content="{Binding Status}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource KpiValue}" FontSize="28"/>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontSize="11" VerticalAlignment="Bottom"/>
                                        <lvc:CartesianChart Grid.Column="1" Height="34" Series="{Binding Spark}" XAxes="{Binding SparkX}" YAxes="{Binding SparkY}"
                                                            TooltipPosition="Hidden" LegendPosition="Hidden" DrawMargin="{x:Null}" IsHitTestVisible="False"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- S-curve -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <StackPanel>
                            <TextBlock Text="S-CURVE  |  PLANNED vs ACTUAL" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Cumulative %, weekly, approved WIR (rework excluded), mean of stages" Style="{StaticResource Small}" FontSize="11"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right">
                            <TextBlock Text="FORECAST COMPLETION" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding ForecastText}" Style="{StaticResource KpiValue}" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ForecastDetail}" Style="{StaticResource Small}" FontSize="11" Margin="0,4,0,0"/>
                    <lvc:CartesianChart Series="{Binding SCurve}" XAxes="{Binding SCurveX}" YAxes="{Binding SCurveY}" LegendPosition="Top" TooltipPosition="Top" Margin="0,6,0,0"/>
                </DockPanel>
            </Border>

            <!-- Needs you today -->
            <Border Grid.Row="2" Grid.RowSpan="5" Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="NEEDS YOU TODAY" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="{Binding QueueCount}" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="QueueList" Style="{StaticResource CardList}" ItemsSource="{Binding Queue}" SelectionChanged="Queue_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Background="{Binding Tag, Converter={StaticResource StatusStripe}}" Margin="-8,-4,0,-4"/>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <ContentControl Style="{StaticResource Tag}" Content="{Binding Tag}"/>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Label}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Chain funnel -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="THE CHAIN  |  FUNNEL" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="{Binding FunnelNote}" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Funnel}" XAxes="{Binding FunnelX}" YAxes="{Binding FunnelY}" LegendPosition="Top" TooltipPosition="Top"/>
                </DockPanel>
            </Border>

            <!-- Donut -->
            <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="POINTS BY SYSTEM" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="QS points of one stage (stages measure the same points)" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <Grid>
                        <lvc:PieChart Series="{Binding Donut}" LegendPosition="Right" TooltipPosition="Center" InitialRotation="-90"/>
                        <TextBlock Text="{Binding DonutTotal}" Style="{StaticResource KpiValue}" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0" IsHitTestVisible="False" x:Name="DonutCenter">
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Heatmap -->
            <Border Grid.Row="6" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="HEATMAP  |  LEVEL x SYSTEM, % GIVEN" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Darker = more given to subcontractors" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Heat}" XAxes="{Binding HeatX}" YAxes="{Binding HeatY}" LegendPosition="Hidden" TooltipPosition="Top"/>
                </DockPanel>
            </Border>

            <!-- WIR ageing -->
            <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="OPEN WIR AGEING" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Days since submission, open WIRs in scope" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Ageing}" XAxes="{Binding AgeingX}" YAxes="{Binding AgeingY}" LegendPosition="Hidden" TooltipPosition="Top"/>
                </DockPanel>
            </Border>

            <!-- Cash flow -->
            <Border Grid.Row="8" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="CASH FLOW  |  CLAIMED vs CERTIFIED" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Monthly increments of cumulative statements, SAR, with cumulative certified" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Cash}" XAxes="{Binding CashX}" YAxes="{Binding CashY}" LegendPosition="Top" TooltipPosition="Top"/>
                </DockPanel>
            </Border>

            <!-- Progress by system per stage -->
            <Border Grid.Row="8" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="DONE % BY SYSTEM AND STAGE" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Approved WIR / QS - stages side by side" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Systems}" XAxes="{Binding SystemsX}" YAxes="{Binding SystemsY}" LegendPosition="Top" TooltipPosition="Top"/>
                </DockPanel>
            </Border>

            <!-- Activity -->
            <Border Grid.Row="8" Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Activity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource Small}" FontSize="10">
                                                <Run Text="{Binding When, Mode=OneWay}" FontFamily="{StaticResource FontMono}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding User, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding Action, Mode=OneWay}" FontWeight="Bold"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
