<UserControl x:Class="Raffaello.App.Views.Pages.LedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- rooms -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ROOMS" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                <TextBox DockPanel.Dock="Top" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Search room, type, level" Margin="0,0,0,8"/>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Code}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Small}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <ProgressBar Style="{StaticResource SlimProgress}" Margin="0,5,0,0" Value="{Binding UsedPct, Mode=OneWay}"/>
                                </StackPanel>
                                <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding Status}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- balances + ledger -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="IMPORT TRACKER" Command="{Binding ImportTrackerCommand}" Margin="12,0,0,0"
                        ToolTip="Read BRANDED_MEP_TRACKER (v19): ROOMS, PROJECT QTY, LEDGER, PLANS. Shows a preview first."/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource YellowBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8"
                            Visibility="{Binding Banner, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource OnYellowBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="0,0,0,6">
                        <Run Text="ROOM BALANCE  |  "/><Run Text="{Binding SelectedRoom.Code, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text="  |  click a row to pre-fill the entry"/>
                    </TextBlock>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Balances}" SelectedItem="{Binding SelectedBalance, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATUS" Width="64" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="100" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Item}" Width="130" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectQty, StringFormat=N2}" Width="72" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="CLAIMED" Binding="{Binding Claimed, StringFormat=N2}" Width="72" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="REMAINING" Binding="{Binding Remaining, StringFormat=N2}" Width="82" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="BY SUBCONTRACTOR" Binding="{Binding BySubs}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="LEDGER LINES  |  APPEND-ONLY (corrections are reversal lines)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource BtnLink}" Content="REVERSE SELECTED" HorizontalAlignment="Right" Command="{Binding ReverseCommand}"
                                ToolTip="Adds a negative line; the reason is taken from NOTES in the entry form"/>
                    </Grid>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATUS" Width="72" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="SUB" Binding="{Binding Line.Subcontractor}" Width="110" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="INV" Binding="{Binding InvoiceLabel}" Width="62" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Line.Stage}" Width="90" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Line.Item}" Width="110" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Line.Qty, StringFormat=N2}" Width="60" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="SITE %" Binding="{Binding Line.SitePct, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="WIR %" Binding="{Binding Line.WirPct, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="WIR NO" Binding="{Binding Line.WirNo}" Width="80" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="CHECKS" Binding="{Binding Checks}" Width="140" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="NOTES / OVER REASON" Binding="{Binding Line.Notes}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- entry + room + plan -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="NEW CLAIM LINE" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="SUBCONTRACTOR" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="2" Text="INVOICE NO" Style="{StaticResource Label}"/>
                            <Grid Grid.Row="1" Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Sub, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Subcontractors}" SelectedItem="{Binding Sub, Mode=TwoWay}" ToolTip="Pick an existing subcontractor" Margin="4,0,0,0"/>
                            </Grid>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                            <TextBlock Grid.Row="2" Text="STAGE" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="ITEM" Style="{StaticResource Label}"/>
                            <ComboBox Grid.Row="3" ItemsSource="{Binding StageOptions}" SelectedItem="{Binding Stage, Mode=TwoWay}" Margin="0,2,0,8"/>
                            <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding ItemOptions}" SelectedItem="{Binding Item, Mode=TwoWay}" Margin="0,2,0,8"/>
                            <TextBlock Grid.Row="4" Text="QTY" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="SITE %  /  WIR %" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="5" Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged, Delay=150}" FontWeight="Bold" Margin="0,2,0,8"/>
                            <Grid Grid.Row="5" Grid.Column="2" Margin="0,2,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SitePct, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Grid.Column="2" Text="{Binding WirPct, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Grid.Row="6" Text="WIR NO" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="HEIGHT CHECK  >4.5 M QTY" Style="{StaticResource Label}"/>
                            <TextBox Grid.Row="7" Text="{Binding WirNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                            <TextBox Grid.Row="7" Grid.Column="2" Text="{Binding QtyAbove45, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                                     ToolTip="Part of QTY installed above 4.5 m (priced at the HIGH item once accepted)"/>
                            <TextBlock Grid.Row="8" Text="LENGTH CHECK  15 M CLAIMED QTY" Style="{StaticResource Label}" Grid.ColumnSpan="3"/>
                            <TextBox Grid.Row="9" Grid.ColumnSpan="3" Text="{Binding LengthClaimed, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"
                                     ToolTip="Pulling qty the subcontractor claims under the 15 m rule (more than QTY). Held from invoicing until the LENGTH CHECK is decided."/>
                        </Grid>
                        <TextBlock Text="NOTES (also the reversal reason)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                        <TextBlock Text="OVER REASON (needed to post above remaining)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding OverReason, UpdateSourceTrigger=PropertyChanged, Delay=200}" Margin="0,2,0,8"/>
                        <Border Style="{StaticResource Well}" Padding="10,8" Margin="0,2,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EntryCheck}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                                <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding EntryStatus}" VerticalAlignment="Top" Margin="8,0,0,0"/>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource BtnPrimary}" Content="POST CLAIM LINE" Command="{Binding AddClaimCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Margin="0,0,0,10"><Run Text="ROOM  "/><Run Text="{Binding SelectedRoom.Code, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="AREA TYPE (selects the lighting BOQ row)" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding AreaTypeOptions}" SelectedItem="{Binding AreaType, Mode=TwoWay}" Margin="0,2,0,8"/>
                        <TextBlock Text="HIGH AREA NOTE" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding HighAreaNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
                        <Button Style="{StaticResource BtnGhost}" Content="SAVE ROOM" Command="{Binding SaveRoomCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding PlanCaption}" Style="{StaticResource Label}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                        <Viewbox Stretch="Uniform" MaxHeight="420">
                            <Grid Width="1000" Height="{Binding PlanHeight}">
                                <Image Source="{Binding PlanImage}" Stretch="Fill"/>
                                <ItemsControl ItemsSource="{Binding Polygons}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Polygon Points="{Binding Points}" Fill="{Binding Fill}" Stroke="{Binding Stroke}" StrokeThickness="{Binding StrokeThickness}"
                                                     ToolTip="{Binding Tip}" Cursor="Hand" Tag="{Binding Room}" MouseLeftButtonUp="OnPolygonClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
