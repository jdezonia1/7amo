<UserControl x:Class="Raffaello.App.Views.Pages.BoqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="BOQ FILE" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}" Margin="0,0,0,10"/>
                    <TextBlock Text="BY SYSTEM" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Systems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Well}" Margin="0,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding System}" Style="{StaticResource BodyStrong}" FontSize="12"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Small}" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="SYSTEM" Style="{StaticResource Label}"/>
                        <ComboBox ItemsSource="{Binding SystemFilters}" SelectedItem="{Binding SystemFilter, Mode=TwoWay}" Width="200"/>
                    </StackPanel>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="SEARCH" Style="{StaticResource Label}"/>
                        <TextBox Style="{StaticResource Input}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                    </StackPanel>
                    <CheckBox Content="ONLY ROWS TO CHECK" IsChecked="{Binding OnlyUnsure}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BtnYellow}" Content="IMPORT BOQ" Command="{Binding ImportCommand}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="SAVE IMPORT" Command="{Binding SaveImportCommand}" Margin="6,0,0,0" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="DISCARD" Command="{Binding DiscardImportCommand}" Margin="6,0,0,0" Visibility="{Binding IsPreview, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"/>
            <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PAGE REF" Binding="{Binding PageRef, Mode=OneWay}" Width="130" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="PROJECT CODE" Binding="{Binding BoqCode}" Width="190" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="CODE FROM" Binding="{Binding CodeSource}" Width="110" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat=N0}" Width="84" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="BY" Binding="{Binding CatSource}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="SCORE" Binding="{Binding CatScore, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Column="4">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="CORRECT THE ROW" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="{Binding Selected.Description}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <TextBlock Text="SYSTEM" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding SystemChoices}" SelectedItem="{Binding EditSystem, Mode=TwoWay}"/>
                    <TextBlock Text="CATEGORY" Style="{StaticResource Label}" Margin="0,6,0,0"/>
                    <ComboBox ItemsSource="{Binding CategoryChoices}" SelectedItem="{Binding EditCategory, Mode=TwoWay}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="APPLY AND LEARN" Command="{Binding ApplyAndLearnCommand}" Margin="0,10,0,0"/>
                    <!-- [assemblies] begin -->
                    <Button Style="{StaticResource BtnGhost}" Content="BREAKDOWN (MATERIALS + RATE)" Command="{Binding BreakdownLineCommand}" Margin="0,6,0,0"/>
                    <!-- [assemblies] end -->
                    <TextBlock Text="The same description gets this system / category automatically from now on." Style="{StaticResource Small}" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="ASK CLAUDE FOR UNCATEGORISED ROWS" Command="{Binding AskClaudeCommand}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="IMPORT CHECKS" Style="{StaticResource PanelTitle}"/>
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,3"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
