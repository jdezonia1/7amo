<UserControl x:Class="Raffaello.App.Views.Pages.AconexWorkflowsSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:views="clr-namespace:Raffaello.App.Views">
    <!-- [phase4] ACONEX SETUP: config file, browser, folders, optional DPAPI-stored login -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SITE AND BROWSER" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="{Binding Validation}" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <TextBlock Text="CONFIG FILE (SELECTORS, COLUMN NAMES, URLS - EDIT WITHOUT RECOMPILING)" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ConfigPath, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="OPEN" Command="{Binding OpenConfigCommand}" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="RELOAD" Command="{Binding ReloadCommand}" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="ACONEX ADDRESS" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" Margin="0,2,0,6"/>
                        <TextBlock Text="PROJECT ID (FROM THE ACONEX URL, IF THE SEARCH PAGES NEED IT)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding ProjectId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" Margin="0,2,0,6"/>
                        <TextBlock Text="BROWSER CHANNEL (msedge = the Edge installed on Windows; chrome; empty = Playwright Chromium)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding BrowserChannel, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" Margin="0,2,0,6"/>
                        <TextBlock Text="BROWSER EXE (OPTIONAL, OVERRIDES THE CHANNEL)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding BrowserExecutablePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" Margin="0,2,0,6"/>
                        <CheckBox Content="Run hidden (headless) - only after the first login worked" IsChecked="{Binding Headless}" Margin="0,4,0,6"/>
                        <TextBlock Text="BROWSER PROFILE (KEEPS THE LOGIN)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBlock Text="{Binding ProfileDir}" Style="{StaticResource Small}" FontFamily="{StaticResource FontMono}" Margin="0,2,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimary}" Content="SAVE" Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnYellow}" Content="OPEN ACONEX / LOG IN" Command="{Binding TestLoginCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="CLOSE BROWSER" Command="{Binding CloseBrowserCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="FOLDERS (SHARED PARTITION)" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="WIR" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WirFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Command="{Binding BrowseWirCommand}"><c:IconView Data="{StaticResource IconFolder}"/></Button></Grid>
                        <TextBlock Text="MIR" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MirFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Command="{Binding BrowseMirCommand}"><c:IconView Data="{StaticResource IconFolder}"/></Button></Grid>
                        <TextBlock Text="OTHER DOCUMENTS" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OtherFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Command="{Binding BrowseOtherCommand}"><c:IconView Data="{StaticResource IconFolder}"/></Button></Grid>
                        <TextBlock Text="WORKFLOW SCREENSHOTS" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ScreenshotFolder, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Command="{Binding BrowseShotsCommand}"><c:IconView Data="{StaticResource IconFolder}"/></Button></Grid>
                        <TextBlock Text="SUB-FOLDER ({yyyy-MM}, {type}, {discipline} - EMPTY = FLAT)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding SubFolderTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,10"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="SAVE" Command="{Binding SaveCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <views:AconexAccountsCard DataContext="{Binding Accounts}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
