<UserControl x:Class="Raffaello.App.Views.Pages.ContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Raffaello.App.ViewModels">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- imports + subcontracts -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="IMPORT" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CONTRACT NO" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ImportContractNo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SUBCONTRACTOR" Style="{StaticResource Label}"/>
                            <TextBox Text="{Binding ImportSub, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="BUILDING" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding BuildingOptions}" SelectedItem="{Binding ImportBuilding, Mode=TwoWay}" ToolTip="Empty = take B5/B6 codes as BRANDED, others as they come"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="CONTRACT LINK WORKBOOK" Command="{Binding ImportLinkWorkbookCommand}" Margin="0,0,6,6"
                                ToolTip="Contract items (English / Arabic), attributes parsed from the text, LINK TABLE item -> BOQ codes"/>
                        <Button Style="{StaticResource BtnGhost}" Content="INVOICE TEMPLATE (INV SHEET)" Command="{Binding ImportTemplateCommand}" Margin="0,0,6,6"
                                ToolTip="The subcontractor's invoice layout: item x BOQ rows, stage %, sections"/>
                        <Button Style="{StaticResource BtnGhost}" Content="PROJECT CODE LIST" Command="{Binding ImportEPromiseCommand}" Margin="0,0,6,6"
                                ToolTip="BOQ codes with cost code / budget resource"/>
                        <Button Style="{StaticResource BtnGhost}" Content="FIX GAS-METER LINKS" Command="{Binding FixGasMeterLinksCommand}" Margin="0,0,6,6"
                                ToolTip="Metering items linked to the BMS lump sum go to the gas-meter codes (B6 6-22-R-18, B5 5-22-P-10, B3 3-22-E-12) - gas meters are done by the electrical subcontractor"/>
                        <Button Style="{StaticResource BtnYellow}" Content="IMPORT CONTRACT PDF" Command="{Binding ImportContractPdfCommand}" Margin="0,0,6,6"
                                ToolTip="The signed contract (scan): header terms, clauses, rate schedule and rules read offline, cross-checked item by item with the Excel; you resolve each difference"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ReadingBusy}" Style="{StaticResource BodyStrong}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="11"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center"><Run Text="CONTRACT DOCUMENTS  "/><Run Text="{Binding SelectedContractNo, Mode=OneWay}"/><Run Text="  (go into the invoice package)"/></TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnLink}" Content="ATTACH" Command="{Binding AttachContractDocCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BtnLink}" Content="REMOVE" Command="{Binding RemoveContractDocCommand}"/>
                        </StackPanel>
                    </Grid>
                    <ListBox ItemsSource="{Binding ContractDocs}" SelectedItem="{Binding SelectedDoc, Mode=TwoWay}" DisplayMemberPath="FileName" MaxHeight="70" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SUBCONTRACTS" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Contracts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Well}" Margin="0,0,0,4" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Contract.Subcontractor}" Style="{StaticResource BodyStrong}" FontSize="12"/>
                                                <TextBlock Text="{Binding Contract.ContractNo}" Style="{StaticResource Small}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Contract.Scope}" Style="{StaticResource Small}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Contract.Value, StringFormat=SAR {0:N0}}" Style="{StaticResource NumTotal}" FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <ListBox Grid.Row="2" Style="{StaticResource TabStrip}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

        <!-- contract items -->
        <Grid Grid.Row="3" Visibility="{Binding IsItems, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ContractNos}" SelectedItem="{Binding SelectedContractNo, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ItemsText}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                        <TextBox Grid.Column="2" Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Item no, description, system"/>
                    </Grid>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" IsReadOnly="False"
                              VirtualizingPanel.IsVirtualizing="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATUS" Width="62" SortMemberPath="Status" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ITEM" Binding="{Binding Item.ItemNo}" Width="46" IsReadOnly="True" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Item.Description}" Width="*" MinWidth="220" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="RATE" Binding="{Binding Item.Rate, StringFormat=N2}" Width="64" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridComboBoxColumn Header="STAGE" SelectedItemBinding="{Binding Item.FixStage}" Width="76"
                                                    ItemsSource="{x:Static vm:ContractsViewModel.FixStageOptions}"/>
                            <DataGridComboBoxColumn Header="CONDUIT" SelectedItemBinding="{Binding Item.ConduitType}" Width="70"
                                                    ItemsSource="{x:Static vm:ContractsViewModel.ConduitOptions}"/>
                            <DataGridComboBoxColumn Header="MOUNT" SelectedItemBinding="{Binding Item.Mount}" Width="76"
                                                    ItemsSource="{x:Static vm:ContractsViewModel.MountOptions}"/>
                            <DataGridComboBoxColumn Header="HEIGHT" SelectedItemBinding="{Binding Item.HeightBand}" Width="62"
                                                    ItemsSource="{x:Static vm:ContractsViewModel.HeightOptions}"/>
                            <DataGridTextColumn Header="SYSTEMS" Binding="{Binding Item.Systems}" Width="130" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding Item.SizeKey}" Width="70" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="STAGE %" Binding="{Binding Item.StagePct}" Width="58" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="LINKS" Binding="{Binding Links}" Width="46" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource PanelTitle}"><Run Text="ITEM "/><Run Text="{Binding SelectedItem.Item.ItemNo, Mode=OneWay}"/></TextBlock>
                        <TextBlock Text="{Binding SelectedItem.Item.Description}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,6" MaxHeight="120"/>
                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap">
                            <Run Text="QTY"/> <Run Text="{Binding SelectedItem.Item.Qty, StringFormat=N2, Mode=OneWay}" FontWeight="Bold"/> <Run Text="{Binding SelectedItem.Item.Unit, Mode=OneWay}"/>
                            <Run Text="  RATE"/> <Run Text="{Binding SelectedItem.Item.Rate, StringFormat=N2, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="  CATEGORY"/> <Run Text="{Binding SelectedItem.Item.Category, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBlock Text="PARSER NOTES" Style="{StaticResource Label}" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding SelectedItem.Item.ParseNotes}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                        <!-- [assemblies] begin -->
                        <Button Style="{StaticResource BtnGhost}" Content="BREAKDOWN (MATERIALS + RATE)" Command="{Binding BreakdownItemCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
                        <!-- [assemblies] end -->
                        <Button Style="{StaticResource BtnPrimary}" Content="SAVE + CONFIRM ATTRIBUTES" Command="{Binding ConfirmItemCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,10"
                                ToolTip="Edit STAGE / CONDUIT / MOUNT / HEIGHT / SYSTEMS / SIZE / STAGE % in the grid, then confirm. Confirmed attributes survive re-imports."/>
                        <TextBlock Text="{Binding ItemLinkCheck}" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding ItemLinkCheck, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="BOQ CODES LINKED TO THIS ITEM" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    </StackPanel>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding ItemLinks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="120" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding BoqDescription}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="SRC" Binding="{Binding Source}" Width="60" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- BOQ -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Visibility="{Binding IsBoq, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="BOQ  |  RATES AND PROJECT QTY" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Coverage}" Style="{StaticResource Label}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" ToolTip="BOQ code, description, cost code"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource BtnGhost}" Content="FILL EMPTY LINES FROM BOQ" Command="{Binding ApplyToLinesCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="SAVE CHANGES" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Boq}" IsReadOnly="False" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATUS" Width="64" SortMemberPath="Status" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="BOQ CODE" Binding="{Binding ItemCode}" Width="130" IsReadOnly="True" ElementStyle="{StaticResource CellKey}"/>
                        <DataGridTextColumn Header="BILL" Binding="{Binding Bill}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="COST CODE" Binding="{Binding Item.CostCode}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="QS LINES" Binding="{Binding QsTotal, StringFormat=N0}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="PROJECT QTY (EDIT)" Binding="{Binding ProjectQty, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="110" ElementStyle="{StaticResource CellNumStrong}"/>
                        <DataGridTextColumn Header="CLAIMED" Binding="{Binding Claimed, StringFormat=N0}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="RATE (EDIT)" Binding="{Binding Rate, UpdateSourceTrigger=LostFocus}" Width="84" ElementStyle="{StaticResource CellNumStrong}"/>
                        <DataGridTextColumn Header="VALUE SAR" Binding="{Binding Value, StringFormat=N0}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridCheckBoxColumn Header="CHANGED" Binding="{Binding IsDirty, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- terms, rules, obligations -->
        <Grid Grid.Row="3" Visibility="{Binding IsTerms, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding ContractNos}" SelectedItem="{Binding SelectedContractNo, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ReaderStatus, Mode=OneWay}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="12,0,0,0" FontSize="10"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding TermsText}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                    <DockPanel Grid.Row="2">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="CONTRACT RULES - WARNINGS ONLY, NEVER BLOCKING (EDIT, THEN SAVE RULE)" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnGhost}" Content="ADD" Command="{Binding AddRuleCommand}"/>
                                <Button Style="{StaticResource BtnGhost}" Content="DELETE" Command="{Binding DeleteRuleCommand}" Margin="6,0,0,0"/>
                                <Button Style="{StaticResource BtnPrimary}" Content="SAVE RULE" Command="{Binding SaveRuleCommand}" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding RuleRows}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled}" Width="40"/>
                                <DataGridTextColumn Header="RULE" Binding="{Binding RuleType}" Width="120"/>
                                <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="PARAMETERS" Binding="{Binding ParamsJson}" Width="200"/>
                                <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemNos}" Width="90"/>
                                <DataGridTextColumn Header="CLAUSE" Binding="{Binding ClauseNo}" Width="56" IsReadOnly="True"/>
                                <DataGridTextColumn Header="P" Binding="{Binding SourcePage}" Width="30" IsReadOnly="True"/>
                                <DataGridTextColumn Header="ORIGIN" Binding="{Binding Origin}" Width="60" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <TextBlock Grid.Row="3" Text="CLAUSES (AS READ FROM THE SIGNED CONTRACT)" Style="{StaticResource PanelTitle}" Margin="0,10,0,6"/>
                    <DataGrid Grid.Row="4" Style="{StaticResource CardGrid}" ItemsSource="{Binding ClauseRows}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CLAUSE" Binding="{Binding ClauseNo}" Width="56"/>
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="140"/>
                            <DataGridTextColumn Header="TEXT" Binding="{Binding TextAr}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FlowDirection" Value="RightToLeft"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="RULES" Binding="{Binding RulesFound}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="OBLIGATIONS CALENDAR (ALL CONTRACTS)" Style="{StaticResource PanelTitle}"/>
                    <Grid Grid.Row="1" Margin="0,6,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="COMPLETION DATE" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding CompletionDate, Mode=TwoWay}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="HANDOVER DATE" Style="{StaticResource Label}"/><DatePicker SelectedDate="{Binding HandoverDate, Mode=TwoWay}"/></StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="SAVE DATES" Command="{Binding SaveDatesCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                    </Grid>
                    <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding ObligationRows}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="90"/>
                            <DataGridTextColumn Header="WHAT" Binding="{Binding Kind}" Width="120"/>
                            <DataGridTextColumn Header="DETAIL" Binding="{Binding Text}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="BYPASSES (WHO / WHEN / WHY)" Style="{StaticResource PanelTitle}" Margin="0,10,0,6"/>
                    <DataGrid Grid.Row="4" Style="{StaticResource CardGrid}" ItemsSource="{Binding BypassRows}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="WHEN" Binding="{Binding BypassedAt, StringFormat=dd-MMM HH:mm}" Width="84"/>
                            <DataGridTextColumn Header="BY" Binding="{Binding BypassedBy}" Width="70"/>
                            <DataGridTextColumn Header="RULE" Binding="{Binding RuleType}" Width="100"/>
                            <DataGridTextColumn Header="ON" Binding="{Binding ContextKey}" Width="120"/>
                            <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- compare contracts -->
        <Grid Grid.Row="3" Visibility="{Binding IsCompare, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TERMS SIDE BY SIDE" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding CompareTerms}" AutoGenerateColumns="True" IsReadOnly="True" MaxHeight="260"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RATES FOR THE SAME KIND OF ITEM (MATCHED BY STAGE, CONDUIT, MOUNT, HEIGHT, CATEGORY, SYSTEMS, SIZE, UNIT)" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding CompareRates}" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>