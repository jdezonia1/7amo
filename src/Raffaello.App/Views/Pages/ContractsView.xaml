<UserControl x:Class="Raffaello.App.Views.Pages.ContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="230"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="SUBCONTRACTS" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Contracts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Well}" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Contract.Subcontractor}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                                            <TextBlock Text="{Binding Contract.ContractNo}" Style="{StaticResource Small}" FontSize="10"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Contract.Scope}" Style="{StaticResource Small}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding CertifiedPct, Mode=OneWay}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Contract.Value, StringFormat=SAR {0:N0}}" Style="{StaticResource NumTotal}" FontSize="12"/>
                                            <TextBlock Text="{Binding CertifiedPct, StringFormat={}{0:P0} certified}" Style="{StaticResource Num}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROJECT QTY COVERAGE" Style="{StaticResource Label}"/>
                    <lvc:PieChart Series="{Binding CoverageSeries}" Height="150" LegendPosition="Hidden" TooltipPosition="Center" InitialRotation="-90"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VALUE BY SYSTEM  |  BOQ / PROJECT / CLAIMED" Style="{StaticResource Label}"/>
                    <lvc:CartesianChart Series="{Binding BoqSeries}" XAxes="{Binding BoqX}" YAxes="{Binding BoqY}" Height="150" LegendPosition="Hidden" TooltipPosition="Top"/>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="BOQ  |  RATES AND PROJECT QTY" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Coverage}" Style="{StaticResource Label}" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Style="{StaticResource BtnGhost}" Content="FILL EMPTY LINES FROM BOQ" Command="{Binding ApplyToLinesCommand}" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource BtnPrimary}" Content="SAVE CHANGES" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Boq}" IsReadOnly="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="STATUS" Width="64" SortMemberPath="Status" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding ItemCode}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CellKey}"/>
                        <DataGridTextColumn Header="BILL" Binding="{Binding Bill}" Width="170" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="BOQ QTY" Binding="{Binding BoqQty, StringFormat=N0}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="QS LINES" Binding="{Binding QsTotal, StringFormat=N0}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="PROJECT QTY (EDIT)" Binding="{Binding ProjectQty, TargetNullValue='', UpdateSourceTrigger=LostFocus}" Width="110" ElementStyle="{StaticResource CellNumStrong}"/>
                        <DataGridTextColumn Header="CLAIMED" Binding="{Binding Claimed, StringFormat=N0}" Width="70" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="RATE (EDIT)" Binding="{Binding Rate, UpdateSourceTrigger=LostFocus}" Width="84" ElementStyle="{StaticResource CellNumStrong}"/>
                        <DataGridTextColumn Header="VALUE SAR" Binding="{Binding Value, StringFormat=N0}" Width="96" IsReadOnly="True" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridCheckBoxColumn Header="CHANGED" Binding="{Binding IsDirty, Mode=OneWay}" Width="70" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
