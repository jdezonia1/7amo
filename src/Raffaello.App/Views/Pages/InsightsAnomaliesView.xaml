<UserControl x:Class="Raffaello.App.Views.Pages.InsightsAnomaliesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Views/Pages/InsightsResources.xaml"/>
    </UserControl.Resources>
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KPI strip -->
        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="HIGH" Style="{StaticResource Label}"/><TextBlock Text="{Binding HighCount}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="MEDIUM" Style="{StaticResource Label}"/><TextBlock Text="{Binding MediumCount}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
            <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="LOW" Style="{StaticResource Label}"/><TextBlock Text="{Binding LowCount}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
            <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="INFO" Style="{StaticResource Label}"/><TextBlock Text="{Binding InfoCount}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
            <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="DISMISSED" Style="{StaticResource Label}"/><TextBlock Text="{Binding DismissedCount}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
            <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Style="{StaticResource BtnYellow}" Content="RE-CHECK (HASH NEW DOCUMENTS)" Command="{Binding RecheckCommand}" Margin="0,0,0,6" ToolTip="Hashes new attachments / photos (SHA-256 + perceptual hash) and runs every check again"/>
                <Button Style="{StaticResource BtnGhost}" Content="EXPORT EXCEL" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- filters -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity, Mode=TwoWay}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind, Mode=TwoWay}" Margin="12,0,0,0" ToolTip="Kind of check"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding Subcontractors}" SelectedItem="{Binding Sub, Mode=TwoWay}" Margin="8,0,0,0" ToolTip="Subcontractor"/>
            <CheckBox Grid.Column="3" Content="SHOW DISMISSED" IsChecked="{Binding ShowDismissed}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <TextBox Grid.Column="4" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Margin="12,0,0,0" ToolTip="Search room, title, explanation"/>
            <TextBlock Grid.Column="5" Text="{Binding StatusText}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="SEVERITY" Width="80" SortMemberPath="Severity">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource SeverityTag}" Content="{Binding Tag}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="120" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="SUB" Binding="{Binding Subcontractor}" Width="130" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="INV" Binding="{Binding InvoiceText}" Width="56" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="ROOM" Binding="{Binding Room}" Width="80" ElementStyle="{StaticResource CellKey}"/>
                <DataGridTextColumn Header="WARNING" Binding="{Binding Title}" Width="*" MinWidth="260" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="DISMISSED" Binding="{Binding Dismissal.Reason}" Width="120" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- detail -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ContentControl Style="{StaticResource SeverityTag}" Content="{Binding Selected.Tag}"/>
                            <TextBlock Text="{Binding Selected.Kind}" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource PanelTitle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="WHY" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding Selected.Explanation}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                        <TextBlock Text="SUGGESTED ACTION" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource Well}" Margin="0,2,0,10">
                            <TextBlock Text="{Binding Selected.SuggestedAction}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="EVIDENCE (CLICK TO OPEN)" Style="{StaticResource Label}"/>
                        <ItemsControl ItemsSource="{Binding Selected.Evidence}" Margin="0,2,0,10" MaxHeight="260">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BtnLink}" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenEvidenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Kind, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Label, Mode=OneWay}"/></TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="DISMISS WITH A REASON (RECORDED)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding DismissReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding Selected.IsDismissed, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Run Text="Dismissed by "/><Run Text="{Binding Selected.Dismissal.DismissedBy, Mode=OneWay}"/><Run Text=" on "/><Run Text="{Binding Selected.Dismissal.DismissedAt, Mode=OneWay, StringFormat=dd MMM yyyy HH:mm}"/>
                        </TextBlock>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource BtnPrimary}" Content="DISMISS" Command="{Binding DismissCommand}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="RESTORE" Command="{Binding RestoreCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="THRESHOLDS" Style="{StaticResource PanelTitle}"/>
                            <ToggleButton Style="{StaticResource ToggleChip}" Content="EDIT" IsChecked="{Binding ShowThresholds}" HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel Visibility="{Binding ShowThresholds, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Thresholds}" IsReadOnly="False" MaxHeight="340">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="KEY" Binding="{Binding Key}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource CellKey}"/>
                                    <DataGridTextColumn Header="VALUE" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}" Width="60" ElementStyle="{StaticResource CellNumStrong}"/>
                                    <DataGridTextColumn Header="MEANING" Binding="{Binding Note}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="SAVE" Command="{Binding SaveThresholdsCommand}" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource BtnGhost}" Content="DEFAULTS" Command="{Binding ResetThresholdsCommand}" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
