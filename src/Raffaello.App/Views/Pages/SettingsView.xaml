<UserControl x:Class="Raffaello.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,20" MaxWidth="1200" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="YOU AND THE DATA FILE" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <TextBlock Text="YOUR NAME (SHOWN IN AUDIT LOG AND PRESENCE)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"/>
                        <TextBlock Text="SHARED DATA FILE (SQLITE, WAL MODE)" Style="{StaticResource Label}" FontSize="10"/>
                        <Grid Margin="0,3,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DataFilePath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnIcon}" Command="{Binding BrowseDataCommand}"><c:IconView Data="{StaticResource IconFolder}"/></Button>
                        </Grid>
                        <TextBlock Text="Point everyone at the same file on the shared drive (e.g. \\server\RAFFLES\raffaello.db). Each save is checked against RowVersion; if someone else changed the row you get a warning instead of overwriting." Style="{StaticResource Small}" FontSize="11" Margin="0,0,0,10"/>
                        <CheckBox Content="Seed the demo project when the data file is empty" IsChecked="{Binding SeedDemoData}" Margin="0,4,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnGhost}" Content="REBUILD DEMO DATA" Command="{Binding ResetDemoCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="START EMPTY" Command="{Binding StartEmptyCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="LOOK" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <TextBlock Text="THEME" Style="{StaticResource Label}" FontSize="10"/>
                        <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme, Mode=TwoWay}" Margin="0,4,0,10"/>
                        <TextBlock Text="ACCENT" Style="{StaticResource Label}" FontSize="10"/>
                        <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Accents}" SelectedItem="{Binding Accent, Mode=TwoWay}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="INVOICE HEADER" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="PROJECT CODE" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding InvoiceProjectCode}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="PROJECT DIRECTOR" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding InvoiceProjectDirector}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="VENDOR NO" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding InvoiceVendorNo}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="6"><TextBlock Text="15 M ROUNDING (DP)" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding LengthRoundingDecimals}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                        </Grid>
                        <TextBlock Text="SIGNATURE NAMES (separated by ;)" Style="{StaticResource Label}" FontSize="10" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding InvoiceSignatureNames}" Margin="0,3,0,0"/>
                        <TextBlock Text="HEAD-OFFICE PACKAGE" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="PACKAGE OUTPUT FOLDER (empty = Documents\Raffaello\Packages)" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding PackageOutputFolder}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="WIR FOLDER (searched by WIR no.)" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding WirFolder}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="PACKAGE NAME ({CONTRACT} {SUB} {INV} {REV})" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding PackageNamePattern}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="TRACKER PASSWORD" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding TrackerPassword}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="RULES" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="WIR DUE AFTER (DAYS)" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding WirDueDays}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="SITE % TOLERANCE (%)" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding SiteTolerance}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="PIPE LENGTH (M PER PCS)" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding PipeLength}" FontFamily="{StaticResource FontMono}" Margin="0,3,0,0"/></StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rules}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Well}" Margin="0,0,0,4">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Style="{StaticResource Tag}" Content="{Binding Code}"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="12" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Small}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <!-- [phase5] begin: data source (local file / Raffaello server) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Server}">
                    <StackPanel>
                        <TextBlock Text="DATA SOURCE" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Sync.Text}" Style="{StaticResource BodyStrong}" FontSize="12"/>
                        <TextBlock Text="{Binding Sync.Detail}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Content="Local (this PC / shared file)" IsChecked="{Binding IsLocal}" GroupName="P5Source" Margin="0,0,16,0"/>
                            <RadioButton Content="Server (URL)" IsChecked="{Binding IsServer}" GroupName="P5Source"/>
                        </StackPanel>
                        <TextBlock Text="SERVER ADDRESS (e.g. http://RAFFAELLO-SRV:5180)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,6"/>
                        <CheckBox Content="Sign in with my Windows account (domain PC)" IsChecked="{Binding UseWindowsAuth}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="APP ACCOUNT" Style="{StaticResource Label}" FontSize="10"/><TextBox Text="{Binding SignInUser, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="PASSWORD" Style="{StaticResource Label}" FontSize="10"/><PasswordBox x:Name="P5Password" Margin="0,3,0,0"/></StackPanel>
                            <Button Grid.Column="4" Style="{StaticResource BtnGhost}" Content="SIGN IN" VerticalAlignment="Bottom" Command="{Binding SignInCommand}" CommandParameter="{Binding ElementName=P5Password}"/>
                        </Grid>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Style="{StaticResource BtnGhost}" Content="TEST CONNECTION" Command="{Binding TestCommand}" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="USE THIS DATA SOURCE" Command="{Binding ApplyCommand}" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource BtnGhost}" Content="RETRY NOW" Command="{Binding RetryCommand}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button Style="{StaticResource BtnGhost}" Content="SYNC CONFLICTS" Command="{Binding ConflictsCommand}" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource BtnGhost}" Content="INVOICE APPROVALS" Command="{Binding ApprovalsCommand}" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource BtnGhost}" Content="MIGRATION DRY RUN" Command="{Binding DryRunCommand}" Margin="0,0,8,6"/>
                            <Button Style="{StaticResource BtnGhost}" Content="COPY LOCAL DATA TO SERVER" Command="{Binding RunMigrationCommand}" Margin="0,0,8,6"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding MigrationReport, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource FontMono}" FontSize="11" MaxHeight="220"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,6,0,0"
                                 Visibility="{Binding MigrationReport, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="Server mode: the data lives on the office server (PostgreSQL). If the server is unreachable you keep working on the last copy; changes are sent when it is back. The migration copies the local file named on the left (ids kept, safe to run twice; ADMIN only)." Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <!-- [phase5] end -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <c:IconView Data="{StaticResource IconSparkles}" Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="ASK RAFFAELLO (CLAUDE)" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding KeyStatus}" Style="{StaticResource BodyStrong}" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock Text="ANTHROPIC API KEY (OR SET ANTHROPIC_API_KEY)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,10"/>
                        <TextBlock Text="MODEL" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,10"/>
                        <TextBlock Text="EFFORT" Style="{StaticResource Label}" FontSize="10"/>
                        <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort, Mode=TwoWay}" Margin="0,4,0,10"/>
                        <CheckBox Content="Server-side fallback if a request is declined (fallbacks: default)" IsChecked="{Binding UseFallbacks}" Margin="0,0,0,8"/>
                        <!-- [phase4] begin -->
                        <CheckBox Content="Variations: re-rank BOQ suggestions with Claude (sends the variation text and item descriptions, no prices)" IsChecked="{Binding VariationsUseClaude}" Margin="0,0,0,8"/>
                        <TextBlock Text="ACONEX CONFIG FILE (EMPTY = %APPDATA%\Raffaello\aconex.config.json)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding AconexConfigPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" FontSize="12" Margin="0,3,0,10"/>
                        <!-- [phase4] end -->
                        <TextBlock Text="The key is stored only in your own settings.json. The selected line's chain, the filter scope and today's queue are sent as context with each question." Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="KEYBOARD" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <TextBlock Style="{StaticResource Body}" FontFamily="{StaticResource FontMono}" FontSize="12" LineHeight="20"
                                   Text="CTRL+K / CTRL+F   command palette, search anything&#10;CTRL+SHIFT+A      Ask Raffaello&#10;CTRL+1 ... CTRL+9 modules&#10;CTRL+H            welcome&#10;CTRL+I            import&#10;CTRL+E            export current view&#10;CTRL+SHIFT+L      light / dark&#10;F5                reload shared data&#10;ESC               close panels"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource BtnPrimary}" Content="SAVE SETTINGS" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="22,9"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
