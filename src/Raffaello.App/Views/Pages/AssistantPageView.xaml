<UserControl x:Class="Raffaello.App.Views.Pages.AssistantPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Raffaello.App.Views">
    <!-- [assistant] ASK RAFFAELLO full page: the same chat as the Ctrl+Shift+A panel, wider -->
    <Border Margin="24,0,24,20" Style="{StaticResource Card}" Padding="0" MaxWidth="1100" HorizontalAlignment="Stretch" ClipToBounds="True">
        <views:AssistantPanel DataContext="{Binding Ask}"/>
    </Border>
</UserControl>
