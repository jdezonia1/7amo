<UserControl x:Class="Raffaello.App.Views.Pages.AconexWorkflowsLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:cv="clr-namespace:Raffaello.App.Converters">
    <!-- [phase4] WORKFLOW LOOKUP: number -> steps, current step, who has it, due / overdue, outcome, screenshot -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Workflow no" Style="{StaticResource Label}"/>
                    <TextBox x:Name="WfBox" Text="{Binding WorkflowNo, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" KeyDown="OnWfKeyDown"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Command="{Binding LookUpCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource OnAccentBrush}"/><TextBlock Text="Look up" Margin="6,0,0,0"/></StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                    <TextBlock Text="Invoice revision (screenshots are attached to IT)" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Style="{StaticResource BtnGhost}" Content="Read screenshot" Command="{Binding ReadScreenshotCommand}" ToolTip="A printed / scanned Aconex workflow screenshot read offline into steps" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Link" Command="{Binding LinkToInvoiceCommand}" ToolTip="Keep this workflow number on the selected invoice revision" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="Export" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource Tag}" Content="{Binding StateTag}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource PanelTitle}"/>
                        <WrapPanel Margin="0,6,0,0">
                            <StackPanel Margin="0,0,24,0"><TextBlock Text="Current step" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding CurrentStep}" Style="{StaticResource BodyStrong}"/></StackPanel>
                            <StackPanel Margin="0,0,24,0"><TextBlock Text="With" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding WithWhom}" Style="{StaticResource BodyStrong}"/></StackPanel>
                            <StackPanel Margin="0,0,24,0"><TextBlock Text="Due" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding Due}" Style="{StaticResource BodyStrong}" Foreground="{DynamicResource AccentBrush}"/></StackPanel>
                            <StackPanel Margin="0,0,24,0"><TextBlock Text="Outcome" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding Outcome}" Style="{StaticResource BodyStrong}"/></StackPanel>
                            <StackPanel><TextBlock Text="Checked" Style="{StaticResource Label}" FontSize="10"/><TextBlock Text="{Binding CheckedAt}" Style="{StaticResource Body}"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Steps}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STEP NAME" Binding="{Binding StepName}" Width="1.3*" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="ASSIGNED TO" Binding="{Binding AssignedTo}" Width="1.8*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DATE IN" Binding="{Binding DateIn, StringFormat=dd MMM yy}" Width="92" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="DATE DUE" Binding="{Binding DateDue, StringFormat=dd MMM yy}" Width="92" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="ORIG. DUE" Binding="{Binding OriginalDueDate, StringFormat=dd MMM yy}" Width="92" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="COMPLETED" Binding="{Binding DateCompleted, StringFormat=dd MMM yy}" Width="92" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding StepStatusText}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="OUTCOME" Binding="{Binding StepOutcome}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DOCUMENT" Binding="{Binding DocumentNo}" Width="1.3*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="REV" Binding="{Binding DocumentRevision}" Width="40" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="3" Text="Rows are the workflow steps as Aconex lists them. A rejected outcome anywhere marks the invoice REJECTED (fix and upload the next revision)." Style="{StaticResource Small}" Margin="2,6,0,0"/>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="Open" Command="{Binding OpenScreenshotCommand}"/>
                        <TextBlock Text="Screenshot" Style="{StaticResource PanelTitle}"/>
                    </DockPanel>
                    <Image Source="{Binding Screenshot, Converter={x:Static cv:PathToImageConverter.Instance}}" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Checks / Changes / Attachments" Style="{StaticResource PanelTitle}" Margin="2,0,0,6"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Earlier checks (click to view)" Style="{StaticResource Label}" FontSize="10"/>
                            <ListBox ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck, Mode=TwoWay}" MaxHeight="120" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Small}"><Run Text="{Binding CheckedAt, StringFormat=dd MMM yy HH:mm, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding State, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding CurrentStep, Mode=OneWay}"/></TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Step changes" Style="{StaticResource Label}" FontSize="10" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,1"><Run Text="{Binding At, StringFormat=dd MMM HH:mm, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding StepName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Field, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding OldValue, Mode=OneWay}"/><Run Text=" -> "/><Run Text="{Binding NewValue, Mode=OneWay}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Attached to the invoice revision" Style="{StaticResource Label}" FontSize="10" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding Attachments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <TextBlock><Run Text="{Binding AddedAt, StringFormat=dd MMM HH:mm, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Kind, Mode=OneWay}"/></TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
