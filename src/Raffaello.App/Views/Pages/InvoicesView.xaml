<UserControl x:Class="Raffaello.App.Views.Pages.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SUBCONTRACTOR" Style="{StaticResource Label}" FontSize="10"/>
                    <ComboBox ItemsSource="{Binding Subcontractors}" SelectedItem="{Binding Subcontractor, Mode=TwoWay}" Width="180"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="STATEMENT" Style="{StaticResource Label}" FontSize="10"/>
                    <ComboBox ItemsSource="{Binding Statements}" SelectedItem="{Binding Statement, Mode=TwoWay}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding InvoiceNo, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding InvDate, StringFormat=dd MMM yy, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Status, Mode=OneWay}"/></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <CheckBox Grid.Column="2" Content="ONLY HELD LINES" IsChecked="{Binding OnlyHeld}" VerticalAlignment="Bottom" Margin="6,0,0,6" FontSize="12"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BtnYellow}" Content="EXPORT CERTIFICATE" Command="{Binding ExportClaimCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="CERTIFY" Command="{Binding CertifyCommand}"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,10" Height="220">
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource HeroCard}">
                    <StackPanel>
                        <TextBlock Text="NET PAYABLE THIS CERTIFICATE" FontFamily="{StaticResource FontSansSemi}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="{Binding Draft.NetPayable, StringFormat=SAR {0:N0}}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="32" Foreground="{DynamicResource HeroInkBrush}"/>
                        <Grid Margin="0,8,0,0" TextElement.Foreground="{DynamicResource HeroInkBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="CLAIMED TO DATE" FontSize="11" Opacity="0.7"/><TextBlock Grid.Column="1" Text="{Binding Draft.ClaimedValue, StringFormat=N0}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                            <TextBlock Grid.Row="1" Text="HELD (ABOVE WIR / CAP)" FontSize="11" Opacity="0.7"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Draft.HeldValue, StringFormat=-{0:N0}}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource YellowBrush}"/>
                            <TextBlock Grid.Row="2" Text="CERTIFIED TO DATE" FontSize="11" Opacity="0.7"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Draft.GrossToDate, StringFormat=N0}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                            <TextBlock Grid.Row="3" Text="PREVIOUS" FontSize="11" Opacity="0.7"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Draft.PreviousGross, StringFormat=-{0:N0}}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                            <TextBlock Grid.Row="4" Text="RETENTION" FontSize="11" Opacity="0.7"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Draft.Retention, StringFormat=-{0:N0}}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                            <TextBlock Grid.Row="5" Text="ADVANCE RECOVERY" FontSize="11" Opacity="0.7"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Draft.AdvanceRecovery, StringFormat=-{0:N0}}" FontFamily="{StaticResource FontMono}" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </ContentControl>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="FROM CLAIM TO NET  |  SAR" Style="{StaticResource Label}"/>
                        <lvc:CartesianChart Series="{Binding Waterfall}" XAxes="{Binding WaterfallX}" YAxes="{Binding WaterfallY}" LegendPosition="Hidden" TooltipPosition="Top"/>
                    </DockPanel>
                </Border>
            </Grid>
            <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATUS" Width="64" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="LINE" Binding="{Binding Key}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="CLAIMED" Binding="{Binding Line.Claimed, StringFormat=N0}" Width="66" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="WIR" Binding="{Binding Line.Done, StringFormat=N0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CAP" Binding="{Binding Line.Cap, StringFormat=N0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CERTIFY" Binding="{Binding Line.Certifiable, StringFormat=N0}" Width="66" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="HELD" Binding="{Binding Line.HeldQty, StringFormat=N0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="PREV" Binding="{Binding Line.PreviousCertified, StringFormat=N0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="PERIOD" Binding="{Binding Line.ThisPeriod, StringFormat=N0}" Width="60" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding Line.Rate, StringFormat=N2}" Width="64" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="TO DATE SAR" Binding="{Binding Line.ValueToDate, StringFormat=N0}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="PERIOD SAR" Binding="{Binding Line.ValueThisPeriod, StringFormat=N0}" Width="86" ElementStyle="{StaticResource CellNum}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <c:ChainPanel Grid.Column="2" DataContext="{Binding Chain}"/>
    </Grid>
</UserControl>
