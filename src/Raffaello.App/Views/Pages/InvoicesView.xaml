<UserControl x:Class="Raffaello.App.Views.Pages.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- stored invoices -->
        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Saved invoices" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter, Mode=TwoWay}" Margin="0,0,0,8" ToolTip="Subcontractor / supplier / owner MOS invoices"/>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Stored}" SelectedItem="{Binding SelectedStored, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="12"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Small}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding Status}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- build + content -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Contract" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding ContractNos}" SelectedItem="{Binding ContractNo, Mode=TwoWay}" Width="190"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Subcontractor" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding Subcontractors}" SelectedItem="{Binding Sub, Mode=TwoWay}" Width="180"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Invoice no" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding InvoiceNo, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BtnPrimary}" Content="Build from ledger" Command="{Binding BuildCommand}" Margin="10,0,0,0"
                            Visibility="{Binding CanBuildFromLedger, Converter={StaticResource BoolToVis}}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Past invoice files" Command="{Binding ImportPastInvoicesCommand}" Margin="6,0,0,0"
                            ToolTip="Import the subcontractor's earlier invoice files (template layout): splits a cumulative ledger block into INV 1..N and stores them as approved invoices"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <Border Background="{DynamicResource YellowBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8" Visibility="{Binding Banner, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{Binding Banner}" Foreground="{DynamicResource OnYellowBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding Heading}" Style="{StaticResource PanelTitle}"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MappingText}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab, Mode=TwoWay}" HorizontalAlignment="Left"/>
                <CheckBox Content="Only rows with quantities" IsChecked="{Binding OnlyMoved}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="{Binding IsLines, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <DataGrid Grid.Row="3" Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" Visibility="{Binding IsLines, Converter={StaticResource BoolToVis}}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding ItemNo}" Width="50" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="120" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="44" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="STAGE %" Binding="{Binding StagePct, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="PREV" Binding="{Binding PrevQty, StringFormat=N2}" Width="62" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CURR" Binding="{Binding CurrQty, StringFormat=N2}" Width="62" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="CUM" Binding="{Binding CumQty, StringFormat=N2}" Width="62" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CURR SAR" Binding="{Binding CurrAmount, StringFormat=N2}" Width="84" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="CUM SAR" Binding="{Binding CumAmount, StringFormat=N2}" Width="84" ElementStyle="{StaticResource CellNum}"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate><TextBlock Text="{Binding Explanation}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="56,2,8,6"/></DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <Grid Grid.Row="3" Visibility="{Binding IsConfirm, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Confirmations}" SelectedItem="{Binding SelectedConfirm, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="CONF." Width="70" SortMemberPath="Confidence">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}" ToolTip="{Binding Confidence}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding Confidence}" Width="84" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="110" ElementStyle="{StaticResource CellKey}"/>
                        <DataGridTextColumn Header="BAND" Binding="{Binding Band}" Width="60" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="80" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="ITEM" Binding="{Binding ItemNo}" Width="50" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="120" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="64" ElementStyle="{StaticResource CellNumStrong}"/>
                        <DataGridTextColumn Header="LINES" Binding="{Binding Lines}" Width="50" ElementStyle="{StaticResource CellNum}"/>
                        <DataGridTextColumn Header="WHY" Binding="{Binding Explanation}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Contract item" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding ItemChoices}" SelectedItem="{Binding LearnItem, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis" MaxWidth="420"><Run Text="{Binding ItemNo, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding Description, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BOQ CODE (linked to the item)" Style="{StaticResource Label}"/>
                            <ComboBox ItemsSource="{Binding BoqChoices}" SelectedItem="{Binding LearnBoq, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis" MaxWidth="420"><Run Text="{Binding BoqCode, Mode=OneWay}" FontWeight="Bold"/><Run Text="  "/><Run Text="{Binding BoqDescription, Mode=OneWay}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="Confirm + learn" Command="{Binding LearnCommand}" VerticalAlignment="Bottom" Margin="10,0,0,0"
                                ToolTip="Stores the choice as a rule (same stage/system/band and item/system/area) and rebuilds"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Visibility="{Binding IsWarnings, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.4*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Warnings}">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Margin="0,10,0,4">
                        <TextBlock Text="Contract checks (from the signed contract)" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="{Binding ContractChecksText}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding ContractWarnings}" SelectedItem="{Binding SelectedContractWarning, Mode=TwoWay}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RULE" Binding="{Binding RuleType}" Width="120" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="WARNING" Binding="{Binding Message}" Width="*" MinWidth="240" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="130" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="BYPASSED" Binding="{Binding Bypass.Reason}" Width="200" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="BY" Binding="{Binding Bypass.BypassedBy}" Width="90" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BypassReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Why the warning is accepted (who agreed, reference). Recorded with your name and the time; printed in the package."/>
                        <Button Grid.Column="1" Style="{StaticResource BtnYellow}" Content="Bypass with reason" Command="{Binding BypassContractWarningCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding SelectedContractWarning.ClauseText}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="3" Style="{StaticResource CardGrid}" ItemsSource="{Binding Diff}" Visibility="{Binding IsDiff, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ITEM" Binding="{Binding ItemNo}" Width="50" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="120" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="CUM BEFORE" Binding="{Binding CumBefore, StringFormat=N2}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CUM AFTER" Binding="{Binding CumAfter, StringFormat=N2}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="QTY CHANGE" Binding="{Binding QtyChange, StringFormat=N2}" Width="80" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="SAR CHANGE" Binding="{Binding AmountChange, StringFormat=N2}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- totals + actions -->
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Totals (SAR)" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="Subcontract value" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding Totals.SubcontractValue, StringFormat=N2}" Style="{StaticResource Num}"/>
                            <TextBlock Grid.Row="1" Text="Previous gross" Style="{StaticResource Label}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Totals.PrevGross, StringFormat=N2}" Style="{StaticResource Num}"/>
                            <TextBlock Grid.Row="2" Text="This period gross" Style="{StaticResource Label}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Totals.CurrGross, StringFormat=N2}" Style="{StaticResource NumTotal}"/>
                            <TextBlock Grid.Row="3" Text="Cumulative gross" Style="{StaticResource Label}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Totals.CumGross, StringFormat=N2}" Style="{StaticResource Num}"/>
                            <TextBlock Grid.Row="4" Text="Retention this period" Style="{StaticResource Label}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Totals.CurrRetention, StringFormat=N2}" Style="{StaticResource Num}"/>
                            <TextBlock Grid.Row="5" Text="Net this period" Style="{StaticResource Label}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Totals.NetCurr, StringFormat=N2}" Style="{StaticResource Num}"/>
                            <TextBlock Grid.Row="6" Text="VAT 15 %" Style="{StaticResource Label}"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Totals.VatCurr, StringFormat=N2}" Style="{StaticResource Num}"/>
                            <TextBlock Grid.Row="7" Text="Net incl. VAT" Style="{StaticResource Label}"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Totals.NetInclVatCurr, StringFormat=N2}" Style="{StaticResource NumTotal}"/>
                        </Grid>
                        <TextBlock Text="Retention %" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding RetentionPct, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource BtnPrimary}" Content="Save draft" Command="{Binding SaveCommand}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="New revision" Command="{Binding NewRevisionCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Workflow" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <TextBlock Text="ACONEX workflow no" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding AconexNo, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Submit" Command="{Binding SubmitCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <TextBlock Text="Rejection reason" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Reject" Command="{Binding RejectCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource BtnYellow}" Content="Approve + lock" Command="{Binding ApproveCommand}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="LOCKED - approved invoices cannot be edited" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource BtnGhost}" Content="Excel (inv layout)" Command="{Binding ExportExcelCommand}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="PDF (filtered)" Command="{Binding ExportPdfCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>
                        <TextBlock Text="Excel keeps every template row with SUM formulas, retention and a QTY BACKUP sheet. The PDF prints only rows with quantities." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Head office" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Attach signed invoice" Command="{Binding AttachSignedCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource BtnGhost}" Content="Draft package" Command="{Binding BuildDraftPackageCommand}" Margin="0,0,4,0"
                                    ToolTip="ZIP without the signed invoice (marked DRAFT)"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="Final package" Command="{Binding BuildFinalPackageCommand}" Margin="4,0,0,0"
                                    ToolTip="Needs the signed invoice attached"/>
                        </UniformGrid>
                        <Button Style="{StaticResource BtnGhost}" Content="Export head-office tracker" Command="{Binding ExportTrackerCommand}" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                ToolTip="Protected values-only workbook: dashboard, plans with clickable rooms, room details, ledger, control"/>
                        <TextBlock Text="{Binding PackageText}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
