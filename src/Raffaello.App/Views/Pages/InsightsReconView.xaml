<UserControl x:Class="Raffaello.App.Views.Pages.InsightsReconView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Views/Pages/InsightsResources.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="3" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="Over-delivered materials" Style="{StaticResource Label}"/><TextBlock Text="{Binding OverDelivered}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="MOS release candidates (SAR)" Style="{StaticResource Label}"/><TextBlock Text="{Binding MosReleaseValue, StringFormat=N0}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}"/>
                        <ItemsControl ItemsSource="{Binding Notes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MaxWidth="700"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnGhost}" Content="Export excel" Command="{Binding ExportCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Theoretical use vs delivered vs invoiced" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Theoretical = installed points (after SITE %) x metres per point. The gap is stock on site or wastage." Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Chart}" XAxes="{Binding ChartX}" YAxes="{Binding ChartY}" LegendPosition="Top" TooltipPosition="Top" Margin="0,6,0,0"/>
                </DockPanel>
            </Border>

            <!-- norms editor -->
            <Border Grid.Row="1" Grid.RowSpan="5" Grid.Column="2" Style="{StaticResource Card}" Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Consumption norms" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8"
                               Text="Material = CABLE|3X2.5 (cable cores x size) or words that must appear (CONDUIT 20MM). System / stage / room type as in the ledger; empty = all. Per point in the material unit."/>
                    <DataGrid Style="{StaticResource EditGrid}" ItemsSource="{Binding Norms}" MinHeight="200" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MATERIAL" Binding="{Binding Material}" Width="110"/>
                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="40"/>
                            <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="62"/>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="62"/>
                            <DataGridTextColumn Header="ROOM TYPE" Binding="{Binding RoomType}" Width="62"/>
                            <DataGridTextColumn Header="PER POINT" Binding="{Binding PerPoint}" Width="58"/>
                            <DataGridTextColumn Header="ALLOW." Binding="{Binding WastageAllowance}" Width="48"/>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Style="{StaticResource BtnPrimary}" Content="Save norms" Command="{Binding SaveNormsCommand}" Margin="0,0,4,4"/>
                        <Button Style="{StaticResource BtnYellow}" Content="Recalculate" Command="{Binding RecalculateCommand}" Margin="4,0,0,4" ToolTip="Recalculate with the norms in the table (before saving)"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Add default norms" Command="{Binding LoadDefaultsCommand}" Margin="0,4,4,0"/>
                        <Button Style="{StaticResource BtnGhost}" Content="Learn from selected" Command="{Binding AdoptObservedCommand}" Margin="4,4,0,0"
                                ToolTip="Scale the selected material's norms so theoretical use = delivered (do it once the work using the material is complete)"/>
                    </UniformGrid>
                    <TextBlock Text="Delivered without a norm" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Unmatched}" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N0}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="40" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Per material" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Selected.Explanation}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" MinHeight="160" MaxHeight="360">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATUS" Width="130" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource SeverityTag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MATERIAL" Binding="{Binding Material}" Width="110" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="INSTALLED PTS" Binding="{Binding InstalledPoints, StringFormat=N0}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="THEORETICAL" Binding="{Binding Theoretical, StringFormat=N0}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="DELIVERED" Binding="{Binding Delivered, StringFormat=N0}" Width="80" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="INVOICED" Binding="{Binding Invoiced, StringFormat=N0}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="PAID" Binding="{Binding Paid, StringFormat=N0}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="ON SITE / WASTE" Binding="{Binding OnSite, StringFormat=N0}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="IMPLIED %" Binding="{Binding ImpliedWastagePct, StringFormat=P0}" Width="66" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="PROJECT NEED" Binding="{Binding TheoreticalTotal, StringFormat=N0}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="OVER" Binding="{Binding OverDelivered, StringFormat=N0}" Width="60" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="OBSERVED / PT" Binding="{Binding ObservedPerPoint, StringFormat=N2}" Width="*" ElementStyle="{StaticResource CellNum}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Owner MOS - Release candidates" Style="{StaticResource PanelTitle}" Margin="0,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="Material still valued as on site in the last MOS valuation that the installed points have (theoretically) used." Style="{StaticResource Small}" FontSize="11" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Mos}" MinHeight="90" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="150" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="DELIVERED" Binding="{Binding Delivered, StringFormat=N0}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="INSTALLED (MOS)" Binding="{Binding InstalledRecorded, StringFormat=N0}" Width="90" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="INSTALLED (THEOR.)" Binding="{Binding InstalledTheoretical, StringFormat=N0}" Width="100" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="RELEASE QTY" Binding="{Binding ReleaseQty, StringFormat=N0}" Width="80" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="RELEASE SAR" Binding="{Binding ReleaseValue, StringFormat=N0}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
