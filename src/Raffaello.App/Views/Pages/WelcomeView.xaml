<UserControl x:Class="Raffaello.App.Views.Pages.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <UserControl.Resources>
        <Style x:Key="ActionTile" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="40,30,40,28" MaxWidth="1240">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- greeting -->
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding DateLine}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="{Binding Greeting}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="46" Foreground="{DynamicResource InkBrush}" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Width="28" Height="3" Background="{DynamicResource YellowBrush}" VerticalAlignment="Center" CornerRadius="2"/>
                        <TextBlock Text="Every quantity. One chain." Style="{StaticResource Body}" FontSize="16" Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <ContentControl Grid.Column="1" Style="{StaticResource HeroCard}" MinWidth="300" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Certified to date" FontFamily="{StaticResource FontSansSemi}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="{Binding CertifiedLine}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="22" Foreground="{DynamicResource HeroInkBrush}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ProgressLine}" FontFamily="{StaticResource FontMono}" FontSize="12" Foreground="{DynamicResource HeroInkBrush}" Opacity="0.75" Margin="0,4,0,0"/>
                    </StackPanel>
                </ContentControl>
            </Grid>

            <!-- since you were last here -->
            <StackPanel Grid.Row="1" Margin="0,26,0,0">
                <TextBlock Text="{Binding SinceWhen}" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <ItemsControl ItemsSource="{Binding Since}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ActionTile}" Margin="0,0,10,0" Padding="14,10"
                                    Command="{Binding DataContext.OpenSinceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border CornerRadius="2" Background="{Binding Status, Converter={StaticResource StatusStripe}}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource KpiValue}" FontSize="30"/>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- three big actions -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource ActionTile}" Command="{Binding ContinueCommand}" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}">
                    <Grid MinHeight="96">
                        <c:IconView Data="{StaticResource IconArrowRight}" Width="28" Height="28" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding ContinueTitle}" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="24"/>
                            <TextBlock Text="{Binding ContinueDetail}" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource ActionTile}" Command="{Binding ImportCommand}">
                    <Grid MinHeight="96">
                        <c:IconView Data="{StaticResource IconImport}" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Import" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="24"/>
                            <TextBlock Text="Qsexport  |  WIR  |  DN  |  Invoice  |  PO  |  Given" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource ActionTile}" Command="{Binding AskCommand}" Background="{DynamicResource HeroBrush}" BorderBrush="{DynamicResource HeroBrush}" Foreground="{DynamicResource HeroInkBrush}">
                    <Grid MinHeight="96">
                        <c:IconView Data="{StaticResource IconSparkles}" Width="28" Height="28" Foreground="{DynamicResource YellowBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Ask RAFFAELLO" FontFamily="{StaticResource FontDisplay}" FontWeight="Bold" FontSize="24"/>
                            <TextBlock Text="Explain a flag, draft an email, summarise the day" FontSize="12" Opacity="0.75"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- queue + recent + data file -->
            <Grid Grid.Row="3" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Needs you today" Style="{StaticResource PanelTitle}"/>
                            <Button Style="{StaticResource BtnLink}" Content="Open dashboard" HorizontalAlignment="Right" Command="{Binding OpenDashboardCommand}"/>
                        </Grid>
                        <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding TopQueue}" x:Name="Queue" SelectionChanged="Queue_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ContentControl Style="{StaticResource Tag}" Content="{Binding Tag}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <c:IconView Grid.Column="2" Data="{StaticResource IconArrowRight}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Recent files &amp; imports" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Well}" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <ContentControl Style="{StaticResource Tag}" Content="{Binding Kind}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding When}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <c:IconView Data="{StaticResource IconDatabase}" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Shared data file" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ContentControl Style="{StaticResource Tag}" Content="Online" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="{Binding DataPath}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource Ink2Brush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DataSize}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding DataModified}" Style="{StaticResource Small}"/>
                            <TextBlock Text="{Binding DataRows}" Style="{StaticResource Small}"/>
                            <Separator/>
                            <TextBlock Text="Who else is editing" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding Presence.OthersOnline}" Style="{StaticResource BodyStrong}" FontSize="12" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Presence.LastSync, StringFormat=last heartbeat {0:HH:mm:ss} (every 60 s)}" Style="{StaticResource Small}" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
