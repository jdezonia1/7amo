<UserControl x:Class="Raffaello.App.Views.Pages.AconexWorkflowsDownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <!-- [phase4] DOCUMENT DOWNLOAD: WIR / MIR from the Document Register into the shared folders, resumable queue, register with SHA-256 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="WHAT TO DOWNLOAD" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="Paste document numbers (one per line, or any text containing them) and / or set filters. Revisions already downloaded are skipped." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnLink}" Content="FROM EXCEL..." Command="{Binding LoadNumbersFromExcelCommand}"/>
                        <TextBlock Text="DOCUMENT NUMBERS" Style="{StaticResource Label}" FontSize="10"/>
                    </DockPanel>
                    <TextBox Text="{Binding NumbersText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AcceptsReturn="True" TextWrapping="NoWrap" Height="120"
                             VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,2,0,2"/>
                    <TextBlock Text="{Binding NumbersInfo}" Style="{StaticResource Label}" FontSize="10" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="DATE FROM" Style="{StaticResource Label}" FontSize="10"/><DatePicker SelectedDate="{Binding DateFrom}" SelectedDateFormat="Short"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="DATE TO" Style="{StaticResource Label}" FontSize="10"/><DatePicker SelectedDate="{Binding DateTo}" SelectedDateFormat="Short"/></StackPanel>
                    </Grid>
                    <TextBlock Text="DOCUMENT TYPE" Style="{StaticResource Label}" FontSize="10"/>
                    <ComboBox ItemsSource="{Binding DocTypes}" Text="{Binding DocType, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,2,0,6"/>
                    <TextBlock Text="DISCIPLINE (AS SHOWN IN ACONEX)" Style="{StaticResource Label}" FontSize="10"/>
                    <TextBox Text="{Binding Discipline, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                    <TextBlock Text="GROUP / CATEGORY" Style="{StaticResource Label}" FontSize="10"/>
                    <TextBox Text="{Binding Group, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding PlanCommand}">
                            <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconSearch}" Width="14" Height="14" Foreground="{DynamicResource OnAccentBrush}"/><TextBlock Text="SEARCH" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource BtnYellow}" Command="{Binding RunCommand}" ToolTip="Downloads (or resumes) the selected queue">
                            <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconImport}" Width="14" Height="14"/><TextBlock Text="DOWNLOAD" Margin="6,0,0,0"/></StackPanel>
                        </Button>
                    </Grid>
                    <Button Style="{StaticResource BtnGhost}" Content="STOP (RESUME LATER)" Command="{Binding StopCommand}" Margin="0,6,0,0"/>
                    <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}" Margin="0,10,0,2"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Label}" FontSize="10"/>
                    <TextBlock Text="{Binding Folders}" Style="{StaticResource Small}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="QUEUE" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock><Run Text="#"/><Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding CreatedAt, StringFormat=dd MMM HH:mm, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding State, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Description, Mode=OneWay}"/><Run Text="  ("/><Run Text="{Binding Total, Mode=OneWay}"/><Run Text=")"/></TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding Queue}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATE" Width="92" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding State}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="DOCUMENT NO" Binding="{Binding DocumentNo}" Width="190" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="REV" Binding="{Binding Revision}" Width="44" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="TYPE" Binding="{Binding DocType}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding DocDate, StringFormat=dd MMM yy}" Width="92" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="TRIES" Binding="{Binding Attempts}" Width="48" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <TextBlock Text="DOWNLOAD REGISTER" Style="{StaticResource PanelTitle}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource BtnGhost}" Content="OPEN FILE" Command="{Binding OpenFileCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="OPEN FOLDER" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="EXPORT" Command="{Binding ExportRegisterCommand}"/>
                </StackPanel>
                <TextBox Grid.Column="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Search number, title or file"/>
            </Grid>
            <DataGrid Grid.Row="4" Style="{StaticResource CardGrid}" ItemsSource="{Binding Register}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DOCUMENT NO" Binding="{Binding DocumentNo}" Width="190" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="REV" Binding="{Binding Revision}" Width="44" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="56" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="FILE" Binding="{Binding FileName}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="ZIP" Binding="{Binding FromZip}" Width="44" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="120" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DOWNLOADED" Binding="{Binding DownloadedAt, StringFormat=dd MMM yy HH:mm}" Width="130" ElementStyle="{StaticResource CellNum}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
