<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [insights] severity / status tags on top of the house Tag style (dark red = high, yellow = medium, soft yellow = low) -->
    <Style x:Key="SeverityTag" TargetType="ContentControl" BasedOn="{StaticResource Tag}">
        <Style.Triggers>
            <Trigger Property="Content" Value="HIGH"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="Content" Value="MEDIUM"><Setter Property="Background" Value="{DynamicResource YellowBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnYellowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/></Trigger>
            <Trigger Property="Content" Value="LOW"><Setter Property="Background" Value="{DynamicResource YellowSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource YellowInkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource YellowSoftBrush}"/></Trigger>
            <Trigger Property="Content" Value="OUTLIER"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="Content" Value="OVER-DELIVERED"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="Content" Value="INVOICED &gt; DELIVERED"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            <Trigger Property="Content" Value="INSTALLED &gt; DELIVERED"><Setter Property="Background" Value="{DynamicResource YellowBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnYellowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource YellowBrush}"/></Trigger>
            <Trigger Property="Content" Value="NO DELIVERY"><Setter Property="Background" Value="{DynamicResource YellowSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource YellowInkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource YellowSoftBrush}"/></Trigger>
            <Trigger Property="Content" Value="OK"><Setter Property="Background" Value="{DynamicResource GoodSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource GoodBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GoodSoftBrush}"/></Trigger>
            <Trigger Property="Content" Value="DISMISSED"><Setter Property="Opacity" Value="0.6"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- editable grid: the house CardGrid with editing on -->
    <Style x:Key="EditGrid" TargetType="DataGrid" BasedOn="{StaticResource CardGrid}">
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="CanUserAddRows" Value="True"/>
        <Setter Property="CanUserDeleteRows" Value="True"/>
    </Style>

    <Style x:Key="KpiBox" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
</ResourceDictionary>
