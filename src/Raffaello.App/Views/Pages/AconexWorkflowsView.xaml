<UserControl x:Class="Raffaello.App.Views.Pages.AconexWorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Raffaello.App.Views.Pages">
    <!-- [phase4] ACONEX hub: status board, workflow lookup, downloads, the old script runner, setup -->
    <Grid Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox Style="{StaticResource TabStrip}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab, Mode=TwoWay}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <ProgressBar Style="{StaticResource SlimProgress}" IsIndeterminate="True" Width="120" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </Grid>

        <pages:AconexWorkflowsBoardView Grid.Row="1" DataContext="{Binding Board}" Visibility="{Binding DataContext.IsBoard, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        <pages:AconexWorkflowsLookupView Grid.Row="1" DataContext="{Binding Lookup}" Visibility="{Binding DataContext.IsWorkflows, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        <pages:AconexWorkflowsDownloadsView Grid.Row="1" DataContext="{Binding Downloads}" Visibility="{Binding DataContext.IsDownloads, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        <pages:AconexView Grid.Row="1" Margin="-24,0,-24,-20" DataContext="{Binding Scripts}" Visibility="{Binding DataContext.IsScripts, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
        <pages:AconexWorkflowsSetupView Grid.Row="1" DataContext="{Binding Setup}" Visibility="{Binding DataContext.IsSetup, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>

        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" CornerRadius="{StaticResource RadiusCard}" Padding="10,6" Margin="0,10,0,0" Height="92">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Log" Foreground="{StaticResource BrandGoldBrush}" FontFamily="{StaticResource FontSansSemi}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource FontMono}" FontSize="11"
                         VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
