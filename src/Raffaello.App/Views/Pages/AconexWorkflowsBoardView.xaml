<UserControl x:Class="Raffaello.App.Views.Pages.AconexWorkflowsBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <!-- [phase4] INVOICE STATUS BOARD: "where is invoice X" -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <UniformGrid Rows="1" Margin="0,0,0,10">
                <ContentControl Style="{StaticResource HeroCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Overdue in ACONEX" Style="{StaticResource Label}" Foreground="{DynamicResource YellowBrush}"/>
                        <TextBlock Text="{Binding OverdueCount}" Style="{StaticResource KpiValue}" FontSize="28" Foreground="{DynamicResource OnAccentBrush}"/>
                    </StackPanel>
                </ContentControl>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Open invoice revisions" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding OpenCount}" Style="{StaticResource KpiValue}" FontSize="28"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Rejected" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding RejectedCount}" Style="{StaticResource KpiValue}" FontSize="28" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Not checked yet" Style="{StaticResource Label}"/>
                        <TextBlock Text="{Binding NotCheckedCount}" Style="{StaticResource KpiValue}" FontSize="28"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BtnPrimary}" Command="{Binding RefreshAllCommand}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal"><c:IconView Data="{StaticResource IconRefresh}" Width="14" Height="14" Foreground="{DynamicResource OnAccentBrush}"/><TextBlock Text="Refresh all" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="Open workflow" Command="{Binding OpenRowCommand}" CommandParameter="{Binding Selected}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="PDF" Command="{Binding ExportPdfCommand}" Margin="0,0,6,0"/>
                    <CheckBox Content="PDF with screenshots" IsChecked="{Binding PdfWithScreenshots}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <CheckBox Content="Show approved / Drafts" IsChecked="{Binding IncludeClosed}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Progress}" Style="{StaticResource Label}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            </Grid>
            <DataGrid x:Name="Grid" Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}" MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATE" Width="92" SortMemberPath="State">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Tag}" ToolTip="{Binding State}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="INVOICE" Binding="{Binding Invoice}" Width="2*" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding InvoiceStatus}" Width="80" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="WORKFLOW" Binding="{Binding WorkflowNo}" Width="96" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="CURRENT STEP" Binding="{Binding CurrentStep}" Width="1.4*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="WITH" Binding="{Binding WithWhom}" Width="1.6*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DUE" Binding="{Binding DateDue, StringFormat=dd MMM yy}" Width="92" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="LATE (D)" Binding="{Binding DaysOverdue}" Width="62" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="OUTCOME" Binding="{Binding Outcome}" Width="*" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="IN WF (D)" Binding="{Binding DaysInWorkflow}" Width="66" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CHECKED" Binding="{Binding LastChecked, StringFormat=dd MMM HH:mm}" Width="90" ElementStyle="{StaticResource CellNum}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Daily auto refresh" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="While Raffaello is open, every invoice workflow is checked once a day at this time (first PC on the shared file does it)." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding AutoRefreshTime, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" ToolTip="HH:mm, e.g. 08:30 - empty = off"/>
                        <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Save" Command="{Binding SaveAutoRefreshCommand}" Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Step changes" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding History}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource BodyStrong}" FontSize="12">
                                        <Run Text="{Binding WorkflowNo, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding StepName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Small}" FontSize="11" TextWrapping="Wrap">
                                        <Run Text="{Binding Field, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding OldValue, Mode=OneWay}"/><Run Text=" -> "/><Run Text="{Binding NewValue, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding At, StringFormat=dd MMM yyyy HH:mm}" Style="{StaticResource Small}" FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
