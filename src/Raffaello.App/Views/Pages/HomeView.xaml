<UserControl x:Class="Raffaello.App.Views.Pages.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls">
    <UserControl.Resources>
        <Style x:Key="AreaTileBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="20,14"/>
            <Setter Property="MinHeight" Value="150"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="MORE">
                    <Setter Property="Background" Value="{DynamicResource HeroBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource HeroInkBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="BigTile">
            <Button Style="{StaticResource AreaTileBtn}" ToolTip="{Binding Inside}"
                    Command="{Binding DataContext.OpenTileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Border Height="3" VerticalAlignment="Top" Background="{StaticResource BrandBandBrush}" CornerRadius="16,16,0,0"/>
                                <ContentPresenter Margin="18,18,18,14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandHoverBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Image Source="{Binding AppIcon, Converter={x:Static c:ResourceKeyConverter.Instance}}" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <c:IconView Data="{StaticResource IconArrowRight}" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,0,0,8">
        <!-- ================= LEVEL 1: big tiles (upper ~55 %) + key figures + needs attention / recent (rest of the page) -->
        <ScrollViewer x:Name="Level1Scroll" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowTiles, Converter={StaticResource BoolToVis}}">
            <Grid Margin="28,0,28,0" MinHeight="{Binding ViewportHeight, ElementName=Level1Scroll}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5.5*" MinHeight="340"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="190"/>
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding Level1}" ItemTemplate="{StaticResource BigTile}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- key figures -->
                <StackPanel Grid.Row="1" Margin="20,4,20,10">
                    <TextBlock Text="Key figures" Style="{StaticResource PanelTitle}" Margin="2,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Figures}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnBase}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" Foreground="{DynamicResource InkBrush}"
                                        Margin="0,0,10,8" Padding="12,8" HorizontalContentAlignment="Stretch" FontWeight="Normal" ToolTip="{Binding Detail}"
                                        Command="{Binding DataContext.OpenFigureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border CornerRadius="2" Background="{Binding Status, Converter={StaticResource StatusStripe}}"/>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding Building, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Label, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- needs attention / recent + quick actions -->
                <Grid Grid.Row="2" Margin="20,0,20,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Needs attention" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Attention}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BtnBase}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource InkBrush}" Padding="6,4" Margin="0,0,0,2"
                                                    HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                    Command="{Binding DataContext.OpenLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="56"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border CornerRadius="2" Background="{Binding Status, Converter={StaticResource StatusStripe}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <c:IconView Grid.Column="3" Data="{StaticResource IconArrowRight}" Width="12" Height="12" Foreground="{DynamicResource MutedBrush}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Recent activity" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="New statement" Command="{Binding NewStatementCommand}" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource BtnGhost}" Content="Tracker plans" Command="{Binding OpenPlansCommand}" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource BtnGhost}" Content="Ask Raffaello" Command="{Binding AskRaffaelloCommand}" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource BtnGhost}" Content="Import recon" Command="{Binding ImportReconCommand}" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Recent}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BtnBase}" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource InkBrush}" Padding="6,3" Margin="0,0,0,2"
                                                    HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                                    Command="{Binding DataContext.OpenLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================= LEVEL 2: MORE = smaller tiles -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowMore, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding More}" ItemTemplate="{StaticResource BigTile}" Margin="28,0" Height="230" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ================= LEVEL 2: plain list of the items in the area -->
        <DockPanel Margin="48,0,48,0" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
            <ListBox x:Name="Links" Style="{StaticResource CardList}" ItemsSource="{Binding Area.Links}" SelectionChanged="Links_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <c:IconView Data="{Binding Icon, Converter={x:Static c:ResourceKeyConverter.Instance}}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{StaticResource Small}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource Ink2Brush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <c:IconView Grid.Column="3" Data="{StaticResource IconArrowRight}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>