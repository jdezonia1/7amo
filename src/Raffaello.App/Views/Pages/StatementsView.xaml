<UserControl x:Class="Raffaello.App.Views.Pages.StatementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Raffaello.App.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- subcontractors + invoices -->
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="SUBCONTRACTORS" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Subs}" SelectedItem="{Binding SelectedSub, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Num}" FontSize="11">
                                            <Run Text="{Binding OverCount, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><Run Text=" OVER"/>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Small}" FontSize="11">
                                        <Run Text="CLAIMED"/> <Run Text="{Binding ClaimedPct, StringFormat=P0, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="  WIR"/> <Run Text="{Binding WirPct, StringFormat=P0, Mode=OneWay}" FontWeight="Bold"/>
                                        <Run Text="  CERT"/> <Run Text="{Binding AvgCertDays, StringFormat={}{0:N0} d, Mode=OneWay}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <Grid Margin="0,4,0,0">
                                        <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding ClaimedPct, Mode=OneWay}" Foreground="{DynamicResource YellowBrush}"/>
                                        <ProgressBar Style="{StaticResource SlimProgress}" Value="{Binding WirPct, Mode=OneWay}" Background="Transparent"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="STATEMENTS" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Invoice.InvoiceNo}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                                        <TextBlock Style="{StaticResource Small}" FontSize="11">
                                            <Run Text="{Binding Invoice.InvDate, StringFormat=dd MMM yyyy, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding Invoice.Status, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ClaimedValue, StringFormat=SAR {0:N0}}" Style="{StaticResource Num}" TextAlignment="Left" FontSize="12"/>
                                    </StackPanel>
                                    <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding Flag}" VerticalAlignment="Top"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- statement lines -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource Tag}" Content="{Binding BannerStatus}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Banner}" Style="{StaticResource BodyStrong}" FontSize="13"/>
                        <TextBlock Text="{Binding InvoiceTotals}" Style="{StaticResource Num}" TextAlignment="Left" FontSize="11" Foreground="{DynamicResource Ink2Brush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <CheckBox Content="ONLY FLAGGED LINES" IsChecked="{Binding OnlyFlagged}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource BtnGhost}" Content="MARK RECEIVED" Command="{Binding MarkReceivedCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="REDO" Command="{Binding MarkRedoCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnGhost}" Content="REJECT" Command="{Binding RejectCommand}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="CERTIFY..." Command="{Binding CertifyCommand}"/>
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="2" Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="STATUS" Width="64" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Style="{StaticResource Tag}" Content="{Binding Status}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="BLDG" Binding="{Binding Row.Building}" Width="66" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="LEVEL" Binding="{Binding Row.Level}" Width="48" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="ROOM" Binding="{Binding Row.Room}" Width="78" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="SYSTEM" Binding="{Binding Row.System}" Width="76" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="STAGE" Binding="{Binding Row.Stage}" Width="66" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="CAP" Binding="{Binding Row.Cap, StringFormat=N0}" Width="48" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="WIR" Binding="{Binding Row.Done, StringFormat=N0}" Width="48" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="PREV" Binding="{Binding PrevQty, StringFormat=N0}" Width="50" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CUM" Binding="{Binding CumQty, StringFormat=N0}" Width="50" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="PERIOD" Binding="{Binding ThisPeriod, StringFormat=N0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CLAIM %" Binding="{Binding ClaimedPct, StringFormat=P0}" Width="62" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="WIR %" Binding="{Binding Row.WirPct, StringFormat=P0}" Width="56" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding Rate, StringFormat=N2}" Width="72" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="VALUE SAR" Binding="{Binding Value, StringFormat=N0}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellNumStrong}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SCORECARD  |  CLAIMED % vs WIR %" Style="{StaticResource Label}"/>
                        <lvc:CartesianChart Series="{Binding ScoreSeries}" XAxes="{Binding ScoreX}" YAxes="{Binding ScoreY}" LegendPosition="Top" TooltipPosition="Top"/>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="INVOICE HISTORY  |  SAR" Style="{StaticResource Label}"/>
                        <lvc:CartesianChart Series="{Binding HistorySeries}" XAxes="{Binding HistoryX}" YAxes="{Binding HistoryY}" LegendPosition="Top" TooltipPosition="Top"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <c:ChainPanel Grid.Column="4" DataContext="{Binding Chain}"/>
    </Grid>
</UserControl>
