<UserControl x:Class="Raffaello.App.Views.Pages.InsightsEarnedValueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/Views/Pages/InsightsResources.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,0,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.ColumnSpan="5" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="SPI (EARNED / PLANNED)" Style="{StaticResource Label}"/><TextBlock Text="{Binding Spi, StringFormat=0.00}" Style="{StaticResource KpiValue}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="ACTUAL" Style="{StaticResource Label}"/><TextBlock Text="{Binding ActualText}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
                    <Border Style="{StaticResource KpiBox}"><StackPanel><TextBlock Text="PLANNED" Style="{StaticResource Label}"/><TextBlock Text="{Binding PlannedText}" Style="{StaticResource KpiValue}"/></StackPanel></Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Small}"/>
                        <ItemsControl ItemsSource="{Binding Notes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" MaxWidth="760"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource BtnGhost}" Content="EXPORT EXCEL" Command="{Binding ExportCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="S-CURVE  |  LEDGER PLANNED vs ACTUAL" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Points within PROJECT QTY after SITE %, stages averaged (never added)" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding Curve}" XAxes="{Binding CurveX}" YAxes="{Binding CurveY}" LegendPosition="Top" TooltipPosition="Top" Margin="0,6,0,0"/>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="PRODUCTIVITY PER SUBCONTRACTOR" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Each bar = one invoice period" Style="{StaticResource Small}" FontSize="11"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding ProdChart}" XAxes="{Binding ProdX}" YAxes="{Binding ProdY}" LegendPosition="Top" TooltipPosition="Top" Margin="0,6,0,0"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PLANNED vs ACTUAL PER STAGE x SYSTEM" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Rows}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="80" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="SYSTEM" Binding="{Binding System}" Width="*" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="PROJECT QTY" Binding="{Binding PlanPoints, StringFormat=N0}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="PLANNED" Binding="{Binding PlannedPct, StringFormat=P0}" Width="58" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="ACTUAL" Binding="{Binding ActualPct, StringFormat=P0}" Width="58" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="SPI" Binding="{Binding Spi, StringFormat=0.00}" Width="48" ElementStyle="{StaticResource CellNumStrong}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FORECAST FINISH PER AREA" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Areas}" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="AREA" Binding="{Binding Area}" Width="*" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="DONE" Binding="{Binding ActualPct, StringFormat=P0}" Width="50" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="PLANNED" Binding="{Binding PlannedFinish, StringFormat=dd-MMM-yy}" Width="74" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="FORECAST" Binding="{Binding ForecastFinish, StringFormat=dd-MMM-yy}" Width="74" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="SLIP D" Binding="{Binding SlipDays, StringFormat=N0}" Width="50" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="METHOD" Binding="{Binding Method}" Width="110" ElementStyle="{StaticResource CellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="5" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PRODUCTIVITY TABLE" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Productivity}" MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SUBCONTRACTOR" Binding="{Binding Subcontractor}" Width="160" ElementStyle="{StaticResource CellKey}"/>
                            <DataGridTextColumn Header="POINTS" Binding="{Binding TotalPoints, StringFormat=N0}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="AVG / INVOICE" Binding="{Binding AvgPerInvoice, StringFormat=N0}" Width="84" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="AVG / WEEK" Binding="{Binding AvgPerWeek, StringFormat=N0}" Width="74" ElementStyle="{StaticResource CellNumStrong}"/>
                            <DataGridTextColumn Header="LAST / WEEK" Binding="{Binding LastPerWeek, StringFormat=N0}" Width="74" ElementStyle="{StaticResource CellNum}"/>
                            <DataGridTextColumn Header="TREND" Binding="{Binding TrendText}" Width="70" ElementStyle="{StaticResource CellText}"/>
                            <DataGridTextColumn Header="PER PERIOD" Binding="{Binding Trend, StringFormat=P0}" Width="*" ElementStyle="{StaticResource CellNum}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Grid.RowSpan="5" Grid.Column="4">
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="EARLY WARNINGS" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Well}" Margin="0,0,0,6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Style="{StaticResource SeverityTag}" Content="{Binding Tag}"/>
                                                <TextBlock Text="{Binding Subject}" Style="{StaticResource BodyStrong}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Action}" Style="{StaticResource Small}" FontStyle="Italic" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="INVOICE PERIOD DATES" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,8"
                                   Text="The tracker ledger has no dates: give the end of the period each invoice covers. Productivity per week, the S-curve and the area forecast use them."/>
                        <DataGrid Style="{StaticResource EditGrid}" ItemsSource="{Binding Periods}" MinHeight="100" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SUBCONTRACTOR" Binding="{Binding Subcontractor}" Width="*"/>
                                <DataGridTextColumn Header="INV" Binding="{Binding InvoiceNo}" Width="40"/>
                                <DataGridTextColumn Header="PERIOD END" Binding="{Binding PeriodEnd, StringFormat=dd-MMM-yyyy}" Width="96"/>
                                <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Style="{StaticResource BtnGhost}" Content="ADD MISSING INVOICES" Command="{Binding AddMissingPeriodsCommand}" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="SAVE DATES" Command="{Binding SavePeriodsCommand}" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
