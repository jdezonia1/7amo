<UserControl x:Class="Raffaello.App.Views.Pages.OwnerMosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,0,24,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="VALUATIONS" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Valuations}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrong}" FontSize="12"/>
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Small}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <ContentControl Grid.Column="1" Style="{StaticResource Tag}" Content="{Binding Status}" VerticalAlignment="Top"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MOS NO" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding No, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="PERIOD TO" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding PeriodTo, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource BtnPrimary}" Content="BUILD" Command="{Binding BuildCommand}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="SAVE DRAFT" Command="{Binding SaveCommand}" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource BtnYellow}" Content="EXPORT EXCEL + PDF" Command="{Binding ExportCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="{Binding Heading}" Style="{StaticResource PanelTitle}"/>
                <TextBlock Text="{Binding Totals}" Style="{StaticResource Label}" Foreground="{DynamicResource AccentBrush}"/>
            </StackPanel>
            <ListBox Grid.Row="2" Style="{StaticResource TabStrip}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,0,0,8"/>

            <DataGrid Grid.Row="3" Style="{StaticResource CardGrid}" ItemsSource="{Binding Lines}" Visibility="{Binding IsValuation, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="150" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding BoqDescription}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="40" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="RATE" Binding="{Binding BoqRate, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="DELIVERED" Binding="{Binding DeliveredQty, StringFormat=N2}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="INSTALLED" Binding="{Binding InstalledQty, StringFormat=N2}" Width="80" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="ON SITE" Binding="{Binding OnSiteQty, StringFormat=N2}" Width="80" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="CUM SAR" Binding="{Binding CumAmount, StringFormat=N2}" Width="96" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="PREV" Binding="{Binding PrevAmount, StringFormat=N2}" Width="90" ElementStyle="{StaticResource CellNum}"/>
                    <DataGridTextColumn Header="CURR" Binding="{Binding CurrAmount, StringFormat=N2}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate><TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Margin="12,2,8,6"><Run Text="{Binding Sources, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding CodeSource, Mode=OneWay}"/></TextBlock></DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <DataGrid Grid.Row="3" Style="{StaticResource CardGrid}" ItemsSource="{Binding Ledger}" SelectedItem="{Binding SelectedLedger, Mode=TwoWay}" Visibility="{Binding IsLedger, Converter={StaticResource BoolToVis}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DN" Binding="{Binding Dn.DnNo}" Width="80" ElementStyle="{StaticResource CellKey}"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Dn.DnDate, StringFormat=dd-MMM-yy}" Width="70" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Line.Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="70" ElementStyle="{StaticResource CellNumStrong}"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding Unit}" Width="40" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="OWNER BOQ" Binding="{Binding BoqCode}" Width="150" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="MIR" Binding="{Binding MirNo}" Width="130" ElementStyle="{StaticResource CellText}"/>
                    <DataGridCheckBoxColumn Header="VALUED" Binding="{Binding Counts, Mode=OneWay}" Width="56"/>
                    <DataGridTextColumn Header="WHY NOT" Binding="{Binding Why}" Width="110" ElementStyle="{StaticResource CellText}"/>
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate><TextBlock Text="{Binding CodeSource}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="12,2,8,6"/></DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <Grid Grid.Row="3" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel><TextBlock Text="BOQ CODE" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding NewInstalledCode, UpdateSourceTrigger=PropertyChanged}" Width="200"/></StackPanel>
                        <StackPanel Margin="8,0,0,0"><TextBlock Text="INSTALLED QTY (CUMULATIVE ADDITION)" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding NewInstalledQty, UpdateSourceTrigger=PropertyChanged}" Width="120"/></StackPanel>
                        <StackPanel Margin="8,0,0,0"><TextBlock Text="NOTE" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding NewInstalledNote, UpdateSourceTrigger=PropertyChanged}" Width="220"/></StackPanel>
                        <Button Style="{StaticResource BtnPrimary}" Content="ADD (AS OF PERIOD TO)" Command="{Binding AddInstalledCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <DataGrid Grid.Row="1" Style="{StaticResource CardGrid}" ItemsSource="{Binding Installed}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="BOQ CODE" Binding="{Binding BoqCode}" Width="180" ElementStyle="{StaticResource CellKey}"/>
                        <DataGridTextColumn Header="QTY" Binding="{Binding Qty, StringFormat=N2}" Width="90" ElementStyle="{StaticResource CellNumStrong}"/>
                        <DataGridTextColumn Header="AS OF" Binding="{Binding AsOf, StringFormat=dd-MMM-yyyy}" Width="100" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="BY" Binding="{Binding UpdatedBy}" Width="100" ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Visibility="{Binding IsWarnings, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Visibility="{Binding IsDiff, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Diff}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,4"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Column="4">
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="WORKFLOW" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="ACONEX WORKFLOW NO" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding AconexNo, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource BtnGhost}" Content="SUBMIT" Command="{Binding SubmitCommand}" Margin="0,6,0,0"/>
                    <TextBlock Text="REJECTION REASON" Style="{StaticResource Label}" Margin="0,10,0,0"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource BtnGhost}" Content="REJECT" Command="{Binding RejectCommand}"/>
                        <Button Style="{StaticResource BtnGhost}" Content="NEW REVISION" Command="{Binding NewRevisionCommand}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource BtnPrimary}" Content="APPROVE AND LOCK" Command="{Binding ApproveCommand}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="12" Visibility="{Binding IsLedger, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="OWNER BOQ CODE FOR THE DN LINE" Style="{StaticResource PanelTitle}"/>
                    <TextBlock Text="{Binding SelectedLedger.Line.Description}" Style="{StaticResource BodyStrong}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                    <ListBox ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" Style="{StaticResource CardList}" MaxHeight="240">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrong}" FontSize="12"/>
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Small}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="OR TYPE THE CODE" Style="{StaticResource Label}" Margin="0,8,0,0"/>
                    <TextBox Style="{StaticResource Input}" Text="{Binding TypedCode, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource BtnPrimary}" Content="SET AND LEARN" Command="{Binding SetCodeCommand}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
