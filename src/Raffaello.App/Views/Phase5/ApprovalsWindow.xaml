<Window x:Class="Raffaello.App.Views.Phase5.ApprovalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raffaello - Invoice approvals" Width="1000" Height="600" WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/raffaello.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource FontSans}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Invoice approvals" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="DRAFT -> CHECKED (QS / reviewer) -> APPROVED (reviewer) -> SUBMITTED. Every stamp records who and when; editing the invoice afterwards makes the stamps stale." Style="{StaticResource Small}" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Invoices}" SelectedItem="{Binding Selected, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="INVOICE" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="BY" Binding="{Binding UpdatedBy}" Width="100"/>
                        <DataGridTextColumn Header="SAVED" Binding="{Binding UpdatedAt, StringFormat=dd-MMM HH:mm}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Stamps" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="Note (optional)" Style="{StaticResource Label}" FontSize="10"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <DataGrid Style="{StaticResource CardGrid}" ItemsSource="{Binding Stamps}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Stage}" Width="100"/>
                            <DataGridTextColumn Header="BY" Binding="{Binding By}" Width="*"/>
                            <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="80"/>
                            <DataGridTextColumn Header="WHEN" Binding="{Binding At, StringFormat=dd-MMM-yy HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock Text="{Binding Message}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="520" TextWrapping="Wrap"/>
            <Button Style="{StaticResource BtnGhost}" Content="Checked" Click="OnChecked" Margin="0,0,8,0"/>
            <Button Style="{StaticResource BtnPrimary}" Content="Approved" Click="OnApproved" Margin="0,0,8,0"/>
            <Button Style="{StaticResource BtnGhost}" Content="Close" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
