<Window x:Class="Raffaello.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raffaello - first start" Width="900" Height="760" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/raffaello.ico"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="{StaticResource FontSans}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="WELCOME TO RAFFAELLO" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Four quick steps. Everything can be changed later in Settings. Nothing is imported unless you confirm." Style="{StaticResource Small}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <CheckBox Content="DEMO MODE (sample project, for training)" IsChecked="{Binding DemoMode}" VerticalAlignment="Center" Margin="0,0,24,0"/>
            <Button Style="{StaticResource BtnGhost}" Content="SKIP" Command="{Binding SkipCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource BtnPrimary}" Content="FINISH" Command="{Binding FinishCommand}"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="1  YOU AND THE DATA" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="YOUR NAME (stamped on every change)" Style="{StaticResource Label}"/>
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>
                        <RadioButton Content="ONE PC / SHARED FILE - a Raffaello data file (put it on the shared drive so the team sees the same data)" IsChecked="{Binding UseLocal}" GroupName="src"/>
                        <Grid Margin="20,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DataFile, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="BROWSE" Command="{Binding BrowseDataCommand}" Margin="6,0,0,0"/>
                        </Grid>
                        <RadioButton Content="SERVER - the office Raffaello server (several users at once, live updates)" IsChecked="{Binding UseServer}" GroupName="src"/>
                        <Grid Margin="20,4,0,4">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}" ToolTip="e.g. http://raffaello-server:5180"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="TEST" Command="{Binding TestServerCommand}" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ServerStatus}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="20,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="2  DOCUMENTS FOLDER" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="One folder on the shared partition for WIR / MIR downloads, invoice packages, variation documents and Aconex screenshots." Style="{StaticResource Small}" TextWrapping="Wrap"/>
                        <Grid Margin="0,6,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DocumentsRoot, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource FontMono}"/>
                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="BROWSE" Command="{Binding BrowseDocumentsCommand}" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Style="{StaticResource BtnYellow}" Content="CREATE FOLDERS" Command="{Binding CreateFoldersCommand}" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding FoldersStatus}" Style="{StaticResource Small}" FontFamily="{StaticResource FontMono}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="3  FIRST IMPORTS (optional)" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <Button Style="{StaticResource BtnGhost}" Content="IMPORT THE TRACKER (rooms, PROJECT QTY, ledger, plans)" Command="{Binding ImportTrackerCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TrackerStatus}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="SUBCONTRACT NO." Style="{StaticResource Label}"/><TextBox Text="{Binding ContractNo, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="SUBCONTRACTOR" Style="{StaticResource Label}"/><TextBox Text="{Binding Subcontractor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="IMPORT CONTRACT LINK WORKBOOK" Command="{Binding ImportContractCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding ContractStatus}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="4  ACONEX" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                        <TextBlock Text="Addresses, selectors and folders are in aconex.config.json (fixable without a new version). Download folders default to the documents folder above." Style="{StaticResource Small}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                            <Button Style="{StaticResource BtnGhost}" Content="OPEN CONFIG" Command="{Binding OpenAconexConfigCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource BtnGhost}" Content="CHECK" Command="{Binding CheckAconexCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AconexStatus}" Style="{StaticResource Small}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
