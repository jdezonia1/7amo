<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "The Link" logo as a DrawingImage (fixed brand colours) for window icons, splash and exports. -->
    <DrawingImage x:Key="LogoImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#151213">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M40,16 L56,32 L40,48 L24,32 Z">
                    <GeometryDrawing.Pen><Pen Brush="#E3AE12" Thickness="6" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M24,16 L40,32 L24,48 L8,32 Z">
                    <GeometryDrawing.Pen><Pen Brush="#8E1B22" Thickness="6" LineJoin="Miter"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M36,20 L28,28">
                    <GeometryDrawing.Pen><Pen Brush="#E3AE12" Thickness="6" StartLineCap="Flat" EndLineCap="Flat"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
