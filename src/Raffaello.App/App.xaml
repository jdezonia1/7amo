<Application x:Class="Raffaello.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/Tokens.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Icons.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Assets/LogoDrawing.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
