<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Raffaello.Core</RootNamespace>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <!-- [phase5] begin: live change notifications from Raffaello.Server -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.31" />
    <!-- [phase5] end -->
    <!-- [phase4] text from variation / EI documents -->
    <!-- [phase3] PDF text layer for the document reader pipeline -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- [cables] DWG / DXF single line diagrams (MIT) -->
    <PackageReference Include="ACadSharp" Version="3.8.0" />
    <!-- [assistant] begin: API key / SMTP password / webhook URLs protected with Windows DPAPI -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- [assistant] end -->
    <!-- [trust] CMS (PAdES-style) PDF signatures; DPAPI package already referenced above -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.1" />
  </ItemGroup>
  <!-- [assistant] begin: interface strings. Both tables are embedded in Raffaello.Core.dll (no satellite assembly, so the
       single-file publish always carries Arabic). -->
  <ItemGroup>
    <EmbeddedResource Update="Localization\Strings.resx" LogicalName="Raffaello.Core.Localization.Strings.resources" />
    <EmbeddedResource Update="Localization\Strings.ar.resx" WithCulture="false" LogicalName="Raffaello.Core.Localization.Strings.ar.resources" />
  </ItemGroup>
  <!-- [assistant] end -->
  <!-- [trust] begin: JSON schema of the CAD exchange file -->
  <ItemGroup>
    <EmbeddedResource Include="Integrations\CadExchange\cad-exchange.schema.json" LogicalName="Raffaello.Core.Integrations.CadExchange.cad-exchange.schema.json" />
  </ItemGroup>
  <!-- [trust] end -->
  <ItemGroup>
    <InternalsVisibleTo Include="Raffaello.Core.Tests" />
    <!-- [phase5] --><InternalsVisibleTo Include="Raffaello.Server.Tests" />
  </ItemGroup>
</Project>
